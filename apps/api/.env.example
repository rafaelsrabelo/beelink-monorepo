NODE_ENV=development
PORT=3001
API_PREFIX=api
DATABASE_URL=postgresql://harness:harness@localhost:5432/harness
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-you-deploy-this

# Mailpit catches everything in development: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Harness <nao-responda@harness.local>

# The links inside e-mails point at the web app
WEB_URL=http://localhost:3000

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=loopback
