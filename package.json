{
  "name": "harness-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:api": "turbo dev --filter=api",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --concurrency=1",
    "storybook": "turbo storybook --filter=@harness-monorepo/ui",
    "ci-check": "bash scripts/ci-check.sh",
    "arch-gates": "bash scripts/arch-gates.sh",
    "docs-gate": "bash scripts/docs-gate.sh",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "changeset": "changeset",
    "prepare": "husky",
    "screenshots": "pnpm --filter web screenshots"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3"
  }
}
