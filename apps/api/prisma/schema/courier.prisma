/// How a courier delivers. The four the landing's form offers; a fifth is a migration, on purpose.
enum CourierVehicle {
  MOTORCYCLE
  BICYCLE
  CAR
  VAN
}

/// A person who asked to deliver with Beelink (BEELINK-321): what the landing's form sent.
///
/// A list of interest and nothing more. It has no status, because nobody works through it yet, and
/// no link to `users`, because asking is not an account. Nothing reads it but a person with `psql`
/// and the outbox of the one e-mail an application is owed (`CourierApplicationNotice`).
///
/// A person is here once (BEELINK-325): a second application with a CPF, an e-mail or a WhatsApp
/// number already on the list is refused by the service, under a lock. Only the CPF has an index
/// of its own — rows from before the rule may repeat an e-mail or a number.
model CourierApplication {
  id String @id @default(uuid(7)) @db.Uuid

  /// As typed, trimmed, with a run of spaces read as one: a first name and a surname at least.
  name     String @db.VarChar(120)
  /// The CPF as its eleven digits, which a CHECK holds it to (`courier_applications_document_check`).
  document String @unique @db.Char(11)
  /// Trimmed and lower-cased. 254 is the address's own ceiling (RFC 5321). Null where the person
  /// was not asked for one (BEELINK-328): the landing's first step takes a name, a CPF and a WhatsApp.
  email    String? @db.VarChar(254)
  /// Digits only, with the country code, the way a shop's WhatsApp is stored — `wa.me/<this>` is
  /// built from it. A CHECK holds it to digits (`courier_applications_whatsapp_check`).
  whatsapp String @db.VarChar(20)

  /// A `CourierCity` of the contracts, as its code: `FORTALEZA_CE`. Text and not an enum of the
  /// database, so opening a city is a change of code and never a migration.
  city    String         @db.VarChar(40)
  vehicle CourierVehicle

  /// The `LegalVersion` in force when the application arrived — the server's word, never the body's.
  termsVersion    String
  termsAcceptedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The e-mail saying it arrived (BEELINK-326). Absent only on a row that repeats an older row's
  /// e-mail, from before the rule: an address is told once.
  notice CourierApplicationNotice?

  @@map("courier_applications")
}

/// The e-mail a person who asked to deliver is owed (BEELINK-326): the application arrived, and the
/// way to go on with it comes later. Written by the transaction that keeps the application — and,
/// once, by the migration, for every address that was on the list already. The outbox of that
/// e-mail, claimed and retried as every outbox is.
///
/// It keeps no address and no name: both are read from the application when the e-mail goes, so
/// there is no second copy to correct, and an application taken out takes its e-mail with it.
/// An address is told once: of two notices whose applications share an e-mail, only the older is
/// ever sent (`CourierApplicationMailer`).
model CourierApplicationNotice {
  id            String             @id @default(uuid(7)) @db.Uuid
  applicationId String             @unique @db.Uuid
  application   CourierApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  /// Sent, or done without sending because an older notice speaks for the address. Given up is
  /// `attempts` at its ceiling with this still null.
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  /// The dispatcher's reading, as on every outbox.
  @@index([nextAttemptAt], where: raw("(\"sentAt\" IS NULL) AND (attempts < 5)"), map: "courier_application_notices_owed_idx")
  @@map("courier_application_notices")
}
