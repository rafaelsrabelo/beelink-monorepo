/// The third parties a shop connects its own account to (BEELINK-182).
enum IntegrationProvider {
  MELHOR_ENVIO
  ASAAS
  /// The shop's Meta Pixel (BEELINK-269): its ID in `pixelId`, public, and nothing sealed.
  META_PIXEL
  /// The shop's Google Analytics (BEELINK-301): its measurement ID in `measurementId`, public, and nothing sealed.
  GOOGLE_ANALYTICS
}

/// Where a connection stands. A shop with no row is disconnected.
enum IntegrationStatus {
  CONNECTED
  /// The third party refused the access it gave: revoked, or left unrenewed past its life. Only the
  /// shopkeeper authorizing again mends it.
  NEEDS_RECONNECT
}

/// Where a webhook registered at a shop's own account stands (BEELINK-202).
enum IntegrationWebhookState {
  /// Registered, and the party sends to it.
  REGISTERED
  /// Not registered: this deployment's web is not public https (development).
  SKIPPED
  /// The party stopped sending after repeated failures; the daily check resumes it (BEELINK-206).
  PAUSED
  /// The party refused the registration, or did not answer it; connecting again retries.
  ERROR
}

/// Where a shop's own account stands with the party that holds it (Asaas, BEELINK-278), in the party's
/// words: its verdict on the whole registration. Only `APPROVED` charges.
enum IntegrationAccountApproval {
  /// The shop has not sent everything the party asks for.
  PENDING
  /// Sent, and being looked at by the party.
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

/// What the party refused of the access a shop gave it, when it is not the whole connection that
/// stopped (Meta, BEELINK-274): the pixel in the browser needs no token and goes on.
enum IntegrationSecretRefusal {
  /// The token is invalid, expired or revoked.
  TOKEN_REJECTED
  /// The party knows no pixel by the saved ID that this token may send to.
  PIXEL_NOT_FOUND
}

/// A shop's connection to its own account at a third party: what that party gave bee-link to act with,
/// sealed, and who the account is. One per shop and party.
model StoreIntegration {
  id       String              @id @default(uuid(7)) @db.Uuid
  storeId  String              @db.Uuid
  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider IntegrationProvider
  status   IntegrationStatus   @default(CONNECTED)

  /// The access itself, as JSON — `{ accessToken, refreshToken }` for Melhor Envio, `{ apiKey }` for
  /// Asaas — sealed with AES-256-GCM under INTEGRATIONS_SECRET_KEY, bound to this shop and party.
  /// Read and written only under src/modules/integrations (gate `api/sealed-secret-in-integrations`).
  /// Empty is nothing sealed: a Meta Pixel's row holds a public ID (BEELINK-269), and is written
  /// with no key set. Its Conversions API token (BEELINK-274) is sealed here like the others, as
  /// `{ accessToken }`, opened only under src/modules/integrations/meta-pixel.
  secretSealed String @default("")

  /// The party refused what is sealed above, and when (Meta, BEELINK-274): nothing is sent with it
  /// again until another is saved, which clears both. Null while it works, or was never tried.
  secretRefusal   IntegrationSecretRefusal?
  secretRefusedAt DateTime?

  /// The shop's Meta Pixel ID (BEELINK-269), on the `META_PIXEL` row alone: 10 to 20 digits and
  /// nothing else, by a CHECK. It is served to anyone in the shop's public data, so the database
  /// itself refuses what a page could not carry safely. Never a script: shops share one domain.
  pixelId String? @db.VarChar(20)

  /// The shop's GA4 measurement ID (BEELINK-301), on the `GOOGLE_ANALYTICS` row alone: `G-` and 6 to
  /// 16 capital letters or digits, by a CHECK, for the pixel's reason — it is served to anyone in the
  /// shop's public data. Never a script or a Tag Manager container.
  measurementId String? @db.VarChar(18)

  /// When the access in hand runs out, and when the means to renew it does. Null for a key that does not.
  accessExpiresAt  DateTime?
  refreshExpiresAt DateTime?
  lastRefreshedAt  DateTime?
  /// What went wrong last, in the party's words, for the logs and the panel; null once it worked again.
  lastError        String?

  /// Whose account it is, as the party names it — shown, never used to act.
  accountId    String?
  accountName  String?
  accountEmail String?
  /// The account's CPF or CNPJ, already masked (BEELINK-202): the panel shows which account it is, and
  /// nothing needs it whole.
  accountDocument String? @db.VarChar(20)

  /// The webhook bee-link registered at the shop's own account (Asaas, BEELINK-202) and where it stands.
  /// Null for a party whose webhook is the app's, registered once for every shop (Melhor Envio).
  webhookId    String?                  @db.VarChar(64)
  webhookState IntegrationWebhookState?
  /// SHA-256, in hex, of the token the webhook sends back — the token itself is sealed with the key. How
  /// the receiver finds the shop without opening every shop's seal.
  webhookTokenHash String? @unique @db.Char(64)
  /// When the webhook was last looked at in the shop's account (BEELINK-206): once a day, which also
  /// keeps the key in use — Asaas disables one left idle for three months.
  webhookCheckedAt DateTime?

  /// Whether the party approved the shop's account (Asaas, BEELINK-278), as last read there, and when.
  /// Null is not known — never read, or the party did not answer — and switches nothing off: only an
  /// account read as not approved stops being charged.
  accountApproval          IntegrationAccountApproval?
  accountApprovalCheckedAt DateTime?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, provider])
  @@index([provider, status, accessExpiresAt])
  @@map("store_integrations")
}

/// A connection the shopkeeper began and the party has not sent back yet: one use, ten minutes, and
/// tied to the shop and the person who began it — the browser coming back must be theirs.
model IntegrationOAuthState {
  state     String              @id
  provider  IntegrationProvider
  storeId   String              @db.Uuid
  userId    String              @db.Uuid
  expiresAt DateTime
  createdAt DateTime            @default(now())

  @@index([expiresAt])
  @@map("integration_oauth_states")
}

/// How a shop ships by carrier (BEELINK-183): which Melhor Envio services it offers, how long it takes
/// to post, and the parcel used for a product with no size. Apart from the connection, so connecting
/// again keeps the shop's choices. None until first saved: then every service is offered.
model MelhorEnvioSettings {
  storeId      String   @id @db.Uuid
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  handlingDays Int      @default(1)
  /// Melhor Envio's service ids. A service it starts offering later stays off until chosen.
  serviceIds   Int[]
  /// The default parcel, all four or none — in the product's units.
  packageWeightGrams Int?
  packageLengthMm    Int?
  packageWidthMm     Int?
  packageHeightMm    Int?
  /// Who sends the labels (BEELINK-187): the shop's CPF or CNPJ, digits only; none, and no label is bought.
  senderDocument      String? @db.VarChar(14)
  /// The shop's state registration, for a commercial shipment with an invoice.
  senderStateRegister String? @db.VarChar(20)
  updatedAt    DateTime @updatedAt

  @@map("melhor_envio_settings")
}

/// How a shop is paid once its Asaas account is connected (BEELINK-203): Pix, credit card and in up to
/// how many instalments, and whether paying on delivery or at pickup stays. Apart from the connection,
/// so connecting again keeps the shop's choices. None until first saved: then the defaults below hold.
model AsaasSettings {
  storeId String  @id @db.Uuid
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pix     Boolean @default(true)
  card    Boolean @default(true)
  /// The most instalments a card payment splits into, 1 to 12 by a CHECK; 1 is in full. Interest-free
  /// to the customer — the instalment fee is the shop's, so going past 1 is the shop's choice.
  maxInstallments Int @default(1)
  /// Paying on delivery or at pickup, settled between the shop and the customer. One of the three is
  /// always on, by a CHECK.
  offline   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("asaas_settings")
}

/// Where an order's label stands at Melhor Envio (BEELINK-187).
enum OrderLabelStatus {
  IN_CART
  PAID
  GENERATED
  CANCELLED
}

/// An order's shipping label, bought from the shop's own Melhor Envio wallet: one per order, for one
/// box. Buying again after a cancellation replaces it. `providerId` is Melhor Envio's id for it, which
/// every later step — pay, generate, print, track, cancel — is asked with.
model OrderLabel {
  orderId    String           @id @db.Uuid
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId    String           @db.Uuid
  providerId String           @db.VarChar(64)
  protocol   String?          @db.VarChar(60)
  status     OrderLabelStatus
  priceCents Int
  weightGrams Int
  lengthMm    Int
  widthMm     Int
  heightMm    Int
  /// The NF-e's key on a commercial shipment; null went with a declaration of contents.
  invoiceKey   String?   @db.Char(44)
  trackingCode String?   @db.VarChar(60)
  createdAt    DateTime  @default(now())
  paidAt       DateTime?
  generatedAt  DateTime?
  cancelledAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([storeId, status])
  @@map("order_labels")
}

/// A third party's event already applied (BEELINK-188): its key is what makes a second delivery of it —
/// a webhook retried, or the periodic check reaching the same fact — a no-op.
model IntegrationEvent {
  key       String              @id @db.VarChar(120)
  provider  IntegrationProvider
  createdAt DateTime            @default(now())

  @@index([createdAt])
  @@map("integration_events")
}

/// What came of a purchase owed to Meta.
enum MetaPurchaseOutcome {
  /// Meta took it.
  SENT
  /// Never sent, and never to be: the shop had no pixel or no token then, the buyer's consent was
  /// gone, or the order no longer counted as a purchase.
  SKIPPED
  /// Meta refused the event itself, or it grew older than Meta takes.
  GIVEN_UP
}

/// A purchase owed to the shop's Meta Pixel from the server (BEELINK-274) — the Conversions API's
/// outbox. Written by the transaction that made the order a purchase: its placement, when it is
/// settled with the shop, or its charge turning paid, when it is charged online — and only for an
/// order its customer placed with a consent kept (`order_marketing_consents`). The unique order id
/// is what makes a purchase owed once. Claimed and retried by `MetaPurchases`; it is also the record
/// of what was told: whether, when, and Meta's last words — never the token.
model OrderMetaPurchase {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId String @db.Uuid

  /// The moment the order counted as a purchase — Meta's `event_time`, and what the seven days it
  /// takes an event within are counted from.
  countedAt DateTime

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  /// Null while it is owed.
  processedAt   DateTime?
  outcome       MetaPurchaseOutcome?
  lastError     String?   @db.VarChar(300)
  createdAt     DateTime  @default(now())

  /// The routine's reading: what is owed and due.
  @@index([nextAttemptAt], where: raw("(\"processedAt\" IS NULL)"), map: "order_meta_purchases_owed_idx")
  /// A shop's waiting purchases, woken when its token is replaced.
  @@index([storeId], where: raw("(\"processedAt\" IS NULL)"), map: "order_meta_purchases_store_owed_idx")
  @@map("order_meta_purchases")
}
