/// How often a plan is charged (BEELINK-219). bee-link's own words: Asaas's are MONTHLY, SEMIANNUALLY
/// and YEARLY, and whoever talks to Asaas translates.
enum BillingCycle {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

/// Where a page stands with bee-link (docs/product/README.md, "What a page costs").
enum SubscriptionStatus {
  /// Inside its free trial. Nothing exists at Asaas.
  TRIALING
  /// The trial ended and the page never paid. A TRIALING row past `trialEndsAt` already reads as this
  /// (`subscription-status.ts`), whether or not anything wrote it.
  TRIAL_EXPIRED
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  /// Owes nothing, by bee-link's own choice.
  EXEMPT
}

/// What a page's charge was paid with, as Asaas told it. Its own enum and not the shops'
/// `PaymentMethod`, which is what a shop takes at the door: that one has cash and no boleto.
enum SubscriptionPaymentMethod {
  CREDIT_CARD
  /// Asaas's invoice offers it beside the other three.
  DEBIT_CARD
  PIX
  BOLETO
}

/// What bee-link sells a page (BEELINK-219). Platform data: the rows come from
/// `prisma/seed/plans.sql`, which every deploy runs and which owns the name, the switch and the
/// prices — a row changed by hand is put back by the next deploy. Never deleted: a plan no longer
/// sold is switched off.
model Plan {
  id     String  @id @default(uuid(7)) @db.Uuid
  /// The key the seed upserts on, and the plan's name in code: `beelink`, `beelink-beelia`.
  slug   String  @unique @db.VarChar(40)
  name   String  @db.VarChar(80)
  /// Off: not listed and not sold. A page already on it keeps it.
  active Boolean @default(false)

  /// What each cycle costs, in whole cents, for the whole cycle and not a month of it — the amount
  /// Asaas is asked to charge. Null: the plan is not sold in that cycle. Each above zero, by a CHECK.
  monthlyPriceCents    Int
  semiannualPriceCents Int?
  annualPriceCents     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions StoreSubscription[]

  @@map("plans")
}

/// A shopkeeper's account as bee-link charges it (BEELINK-219): one Asaas customer per account, at
/// bee-link's own Asaas account, whatever the number of pages. Its own table and not a column of
/// `users`, which holds the shops' customers too and knows nothing of Asaas. No row until the
/// shopkeeper gives their billing data (BEELINK-291).
///
/// The row is written and committed before Asaas is asked anything, and Asaas is never asked with a
/// lock held: `asaasCustomerClaimedUntil` is what lets one request at a time talk to Asaas about the
/// account's customer, as `orders.paymentClaimedUntil` does about an order's charge.
model BillingAccount {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Who is charged, as Asaas is told: a person's name or a company's. The e-mail is the account's
  /// own and is not copied here; a phone and an address are not kept.
  name     String @db.VarChar(120)
  /// A CPF or a CNPJ with no punctuation — eleven digits, or twelve digits or capital letters and two
  /// digits, by a CHECK. Whether its check digits hold is the API's to say. Answered masked, always.
  document String @db.VarChar(14)

  /// Asaas's id of the customer, `cus_…`. Null while the row exists and the customer does not yet:
  /// the row may be written before Asaas is called.
  asaasCustomerId           String?   @unique @db.VarChar(64)
  /// When Asaas came to hold this very name and document. Null: what the row says was not told to
  /// Asaas yet — never, or not since it last changed.
  asaasCustomerSyncedAt     DateTime?
  /// Until when one request holds the talk with Asaas about this customer. Null, or in the past: free.
  /// Pushed ahead after a creation Asaas left unanswered, so nobody creates again before a customer
  /// it did make had time to show in a search.
  asaasCustomerClaimedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("billing_accounts")
}

/// A page's subscription (BEELINK-219): one per store, written in the transaction that creates the
/// store and deleted with it. A store from before this table has none until it is given one.
///
/// It has an id of its own, apart from the store's, for whatever names it from outside this table —
/// the reference Asaas is given, a row about one of its charges — so that none of them carries the
/// store's id as if it were the subscription's.
///
/// The three `…EndsAt` are instants, and exclusive: each is the first instant that thing is over, so
/// all three are compared the same way. Until what hour of a day something lasts is decided once, by
/// whoever writes the column.
model StoreSubscription {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @unique @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  status SubscriptionStatus @default(TRIALING)

  /// When the store was created: the trial is counted from it, for every store.
  trialStartedAt DateTime
  /// The midnight in Brasília that closes the seventh day after the day it began (`billing-dates.ts`).
  /// After `trialStartedAt`, by a CHECK.
  trialEndsAt    DateTime

  /// What the shopkeeper chose: null until they do, and the three together or none, by a CHECK.
  planId     String?       @db.Uuid
  /// Restrict: a plan a page is on is switched off, never deleted.
  plan       Plan?         @relation(fields: [planId], references: [id], onDelete: Restrict)
  cycle      BillingCycle?
  /// What the cycle costs this page, as agreed when it was chosen, in whole cents. Kept here because
  /// the plan's price follows the seed, and Asaas goes on charging what the subscription was made with.
  priceCents Int?

  /// The paid period's end. Null while nothing was paid.
  currentPeriodEndsAt DateTime?
  /// The first instant a page past due is locked (BEELINK-223): seven days after its paid period ended
  /// or, with no period to count from, after the day it was found past due. Written once the page is
  /// found past due — by a read of Asaas or by the billing routine's clock — and never moved earlier;
  /// cleared once it pays, and kept on a suspended page, saying when its grace ran out. The lock, the
  /// panel's notice and the e-mails read this one date.
  graceEndsAt         DateTime?
  /// When the shopkeeper asked to cancel. Asaas removes its subscription at once and gives nothing
  /// back, so the page goes on until `currentPeriodEndsAt`, which only bee-link knows.
  cancelRequestedAt   DateTime?
  /// The end of a free period given by a coupon, during which nothing exists at Asaas. Null with none.
  freePeriodEndsAt    DateTime?

  /// Asaas's id of the subscription, `sub_…`. Null until one is made. This, the plan, the cycle, the
  /// price, `firstDueDate` and `invoiceUrl` tell of the one subscription standing at Asaas, and are
  /// written together once Asaas answered — never a cycle that was only asked for (BEELINK-292).
  asaasSubscriptionId           String?   @unique @db.VarChar(64)
  /// Until when one request holds the talk with Asaas about this page's subscription. Null, or in the
  /// past: free. Written and committed before Asaas is asked, so no lock is held while it answers;
  /// pushed ahead after a creation Asaas left unanswered, so nobody creates again before a
  /// subscription it did make had time to show in a search.
  asaasSubscriptionClaimedUntil DateTime?
  /// The due day of that subscription's first charge, a day of Brasília's calendar. Every renewal is
  /// counted from this day, never from the renewal before: a subscription begun on 31/10 renews on
  /// 30/11 and then on 31/12, and the 30 alone cannot say so.
  firstDueDate                  DateTime? @db.Date

  /// Null until Asaas tells of a payment: a subscription is made with no method chosen.
  paymentMethod SubscriptionPaymentMethod?
  /// Asaas's hosted invoice of the charge waiting to be paid whose period is not over. Null with none
  /// waiting.
  invoiceUrl    String?                    @db.VarChar(500)
  /// All that is kept of a card, the two together or none, by a CHECK: its brand in Asaas's word and
  /// its last four digits. No column holds a number, a holder, a validity or a token.
  cardBrand     String?                    @db.VarChar(20)
  cardLast4     String?                    @db.Char(4)

  /// The instant the read of Asaas whose facts this row holds began (BEELINK-221): status, period,
  /// method, card and invoice. A read that began before it is never written over it, so two reads at
  /// once end with the newer whichever finishes last. Null until Asaas was first read for the page.
  asaasCheckedAt DateTime?
  /// When the billing routine is to read Asaas for this page again (BEELINK-221): set by every read,
  /// by where the page stands — near the end of a paid period, further and further apart while a
  /// charge waits — and pushed ahead before the routine asks. Null: the routine leaves it alone.
  nextCheckAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The page's one coupon of bee-link's, once it used it (BEELINK-224).
  couponRedemption PlatformCouponRedemption?

  @@index([planId])
  @@index([nextCheckAt])
  // The billing routine's clock moves pages by where they stand: a trial, a paid period or a grace that ended.
  @@index([status])
  @@map("store_subscriptions")
}

/// An event of bee-link's own Asaas webhook (BEELINK-221), written before it is answered and worked
/// after, the way `asaas_events` holds a shop's. Its body is never applied — working one is reading
/// Asaas for the page it is about — so all that is kept of it is its id, its name and that page.
model BillingEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Asaas's id of the event, `evt_…`; the SHA-256 of the body for one that came with none. Unique:
  /// what makes a second delivery a no-op. The account is one, so the id alone is.
  eventId        String    @unique @db.VarChar(160)
  /// `PAYMENT_RECEIVED`, `SUBSCRIPTION_DELETED`…
  event          String    @db.VarChar(80)
  /// The row of `store_subscriptions` it is about; null for one about nothing of bee-link's, which is
  /// written done. Not a relation: an event may name a page deleted since, and is kept all the same to
  /// tell a second delivery by.
  subscriptionId String?   @db.Uuid
  /// What came of it: APPLIED, IGNORED, or GIVEN_UP after the last try. Null while it waits.
  outcome        String?   @db.VarChar(20)

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  processedAt   DateTime?
  lastError     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())

  @@index([processedAt, nextAttemptAt])
  @@map("billing_events")
}

/// A coupon of bee-link's own (BEELINK-224): a code that gives a page one free month — never a discount
/// — once in the page's life, while it is on, in date and under its limit. Nothing is made at Asaas for
/// it. Made, listed and switched off by a command run in the API's container
/// (`dist/scripts/platform-coupon.js`), so no code is ever written in this repository, which is public.
/// Not a shop's `Coupon`, which takes money off an order.
model PlatformCoupon {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and in upper case, so the unique index means "whatever the case": A–Z, 0–9, `-` and
  /// `_`, 3 to 30 of them, by a CHECK — the shape a shop's coupon has, so one is typed as the other.
  code String @unique @db.VarChar(30)

  /// The first instant it gives nothing: the midnight in Brasília closing the last day it was made
  /// for. Null never expires.
  expiresAt       DateTime?
  /// How many pages may use it; null is no limit. Above zero, by a CHECK.
  maxRedemptions  Int?
  /// How many pages used it. Moved only by the transaction that writes a use, by an UPDATE whose
  /// condition is that the coupon still holds, so two uses at once never pass the limit together — and
  /// never past it at all, by a CHECK. Never moved down: a use given is spent, even once its page is gone.
  redemptionCount Int       @default(0)
  /// When it was switched off; null while it is on. Switching it off takes back no month it gave.
  disabledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PlatformCouponRedemption[]

  @@map("platform_coupons")
}

/// One use of a coupon of bee-link's (BEELINK-224): the page's subscription it was used on — one per
/// page, by the unique index — and the free month it gave. Deleted with the page.
model PlatformCouponRedemption {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// Restrict: a coupon used is switched off, never deleted.
  couponId       String            @db.Uuid
  coupon         PlatformCoupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  subscriptionId String            @unique @db.Uuid
  subscription   StoreSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// The free month it gave, as instants: from the later of the use, the trial's end and a free period
  /// still running, to the midnight in Brasília closing the same day a month later. The page's own
  /// `freePeriodEndsAt` is what the lock reads; these say where it came from. The end after the start,
  /// by a CHECK.
  freePeriodStartsAt DateTime
  freePeriodEndsAt   DateTime

  /// When the page used it.
  createdAt DateTime @default(now())

  /// A coupon's uses, the most recent first.
  @@index([couponId, createdAt(sort: Desc)])
  @@map("platform_coupon_redemptions")
}
