/// A shop's own record of someone who buys from it (docs/product/README.md, "Customers"): a name, a
/// phone and their addresses, remembered so they are not typed again. It belongs to the shop; the account
/// it may be linked to is bee-link's, and no shop ever reads that account through it.
///
/// The same person buying from two shops is two customers. The phone identifies one within a shop,
/// and is optional because an account signs up with an e-mail — the phone arrives with the first
/// order.
model Customer {
  id           String   @id @default(uuid(7)) @db.Uuid
  storeId      String   @db.Uuid
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// The account, when the shopper signed in. Null for one known only by an order.
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  /// Digits only, with the country code, as `wa.me` wants it.
  phone        String?
  /// The phone the account tried to save when another record of the shop had it — the only trace
  /// the unique index leaves of one person with two records. The panel flags the pair and the
  /// shopkeeper merges them; nothing is merged from it on its own. Cleared once a phone is saved.
  claimedPhone String?
  /// The eleven digits, checked when saved; given by the shopper for the shop's invoice. Not unique:
  /// a refusal would tell a stranger the number is a customer here.
  cpf          String?   @db.Char(11)
  /// A day, no time: when the shopper was born, if they said.
  birthDate    DateTime? @db.Date
  /// The shopper's notices by e-mail (BEELINK-151): their orders' progress, on until they turn it off.
  notifyOrders    Boolean   @default(true)
  /// A favourite that got cheaper or came back in stock (sent by J16): on, since the shopper chose the favourite.
  notifyFavorites Boolean   @default(true)
  /// The shop's offers and news: off until the shopper says yes. `notifyOffersAt` is when they last
  /// chose either way — the consent's date, kept.
  notifyOffers    Boolean   @default(false)
  notifyOffersAt  DateTime?
  /// The shop's books on this customer, kept by the transaction that places or cancels an order so
  /// the list can filter and sort by them without reading the orders. Cancelled ones do not count.
  ordersCount     Int       @default(0)
  /// BigInt: one order is capped, a customer's lifetime is not, and an overflow here would fail
  /// every later order of theirs.
  totalSpentCents BigInt    @default(0)
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  addresses CustomerAddress[]
  favorites CustomerFavorite[]
  favoriteNotices FavoriteNotice[]
  reviews   ProductReview[]

  @@unique([storeId, userId])
  @@unique([storeId, phone])
  @@index([userId])
  @@index([storeId, claimedPhone])
  /// The CRM's stage filter and its "latest order" sort.
  @@index([storeId, lastOrderAt])
  @@map("customers")
}

/// One place a customer receives orders (BEELINK-148): home, work. A customer has none until they
/// give one, and one of them is the default: where an order goes unless another is chosen, and the
/// address the panel reads and writes. At most one default per customer, by the partial unique index;
/// exactly one while there are any, kept so by the service.
model CustomerAddress {
  id            String   @id @default(uuid(7)) @db.Uuid
  customerId    String   @db.Uuid
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// What the customer calls it — "Casa", "Trabalho"; null when they gave it no name.
  label         String?
  /// Who receives an order there; null is the customer, by the name they have when the order is placed.
  recipientName String?
  zipCode       String?
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  /// Two letters, upper case.
  state         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([customerId], where: { isDefault: true }, map: "customer_addresses_one_default_key")
  @@index([customerId])
  @@map("customer_addresses")
}
