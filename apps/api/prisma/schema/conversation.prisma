/// Who wrote a message of an order's conversation: its customer, or the shop — or nobody, for the
/// notice of a status the order moved to (BEELINK-236).
enum ConversationAuthor {
  CUSTOMER
  SHOP
  SYSTEM
}

/// What a notice tells beyond a status (BEELINK-207).
enum OrderMessageNotice {
  /// The order's online payment was approved. Such a notice has no status.
  PAYMENT_APPROVED
  /// On a CANCELLED notice: bee-link cancelled the order because nobody paid it in time.
  CANCELLED_UNPAID
  /// Money of the order's payment was given back (BEELINK-208): `refundCents` says how much. No status.
  PAYMENT_REFUNDED
}

/// The customer's conversation with the shop about one order (BEELINK-160). Born with the order when
/// its customer has an account to read it, or with the order's next move for one placed before
/// (BEELINK-236). Whether it takes messages is the order's status, never a column: it closes when the
/// order is delivered or cancelled, and a flag here could say otherwise.
model OrderConversation {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// When its last message was written: what the lists sort by.
  lastMessageAt DateTime

  createdAt DateTime @default(now())

  messages OrderMessage[]

  @@index([lastMessageAt])
  @@map("order_conversations")
}

/// One message, as written, or the notice of a status. Unread is a message the other side has not
/// read: `readAt` is theirs — a notice's other side is the customer.
model OrderMessage {
  id             String            @id @default(uuid(7)) @db.Uuid
  conversationId String            @db.Uuid
  conversation   OrderConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  author ConversationAuthor
  /// The account that wrote it — the shopper's, or a shopkeeper's. Null on a notice.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Plain text, up to 2000 characters, never drawn as HTML. Empty on a notice, which each side
  /// words for itself from `status`.
  body      String       @db.VarChar(2000)
  /// The status a notice tells of. A SYSTEM line has a status, a `notice`, or both, and nothing else
  /// has either (a CHECK holds it).
  status    OrderStatus?
  /// What the notice tells beyond its status (BEELINK-207); null on a plain move and on a message.
  notice    OrderMessageNotice?
  /// On a delivery's notice, the cashback it made usable (BEELINK-239): told as it was then, like
  /// the status itself. Null on every other message.
  cashbackCents Int?
  /// On a refund's notice (BEELINK-208), how much went back. Null on every other message.
  refundCents   Int?
  createdAt DateTime     @default(now())
  /// When the other side read it; null while they have not.
  readAt    DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, author, readAt])
  @@map("order_messages")
}
