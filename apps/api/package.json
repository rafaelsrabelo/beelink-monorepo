{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "db:seed": "prisma db seed",
    "db:seed:dev": "prisma db execute --file prisma/seed/dev-catalog.sql",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "oxlint src/ test/ --ignore-pattern 'src/generated/**'",
    "type-check": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "prisma generate && vitest run --coverage",
    "test:e2e": "prisma generate && vitest run --config ./vitest.config.e2e.ts",
    "perf:catalog": "prisma generate && TEST_DATABASE_URL=${PERF_DATABASE_URL:-postgresql://harness:harness@localhost:5432/harness_perf_test} vitest run --config ./vitest.config.perf.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "nestjs-pino": "^5.1.0",
    "nodemailer": "^10.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@harness-monorepo/contracts": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@oxc-project/runtime": "^0.149.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "4.1.11",
    "fastify": "5.12.1",
    "oxlint": "^1.58.0",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
