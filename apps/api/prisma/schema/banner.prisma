/// Where a banner sends the visitor.
///
/// This is the piece the first attempt lacked, and the reason it was removed. The old
/// `store_showcases` kept its destination as a free-text `href`, so a banner pointing at
/// `/lessari/blusas` became a dead link the day that category was renamed, and nothing said so.
/// Commit `5639c47` deleted the table and wrote down what went with it — "banner apontando para um
/// produto específico ou para fora da loja" — and this enum is that sentence being paid back.
///
/// CATEGORY and PRODUCT carry a foreign key, never an address: the address is built where it is
/// rendered, from the slug the row has now, so renaming the thing a banner points at moves the
/// banner with it. EXTERNAL is the only one that stores a string, because there is nothing here to
/// point at — another website, or a wa.me link.
enum BannerTarget {
  CATEGORY
  PRODUCT
  EXTERNAL
}

/// A poster on a shop's landing page.
///
/// It is a row again, and that reverses `5639c47` on purpose. That commit was right that a poster
/// carrying a title, a picture and a description which `ProductCategory` already had was one
/// entity too many — "dois nomes para uma coisa são duas telas para manter em dia". What it could
/// not do was point at a product or out of the shop, and it said so. A banner keeps the shape and
/// adds the destination, and `ProductCategory.showcaseLayout` goes away in the same migration so
/// there is still exactly one way to put a poster on the home.
///
/// It carries its own `layout` and `position` rather than leaving them to a layout document. That
/// is what lets a banner appear the moment it is created, instead of waiting for an editor that
/// does not exist yet — and the drag-to-arrange ticket becomes a writer of `position` rather than
/// a prerequisite for seeing anything at all.
model StoreBanner {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title    String  @db.VarChar(120)
  /// The line under the title. Optional: a poster of a photograph often says enough.
  subtitle String? @db.VarChar(200)
  /// Required, unlike a category's. A card of solid colour with words on it is not a banner — that
  /// rule used to live in the web, which quietly skipped a poster with no picture; here the
  /// database refuses to store one.
  imageUrl String

  /// Full width, two across, three across. The same three shapes a category poster had, and the
  /// same enum: a second one would be two vocabularies for one row of the page.
  layout ShowcaseLayout

  target BannerTarget

  /// Cascade, not SetNull, and the reason is the CHECK below. A banner whose target is a category
  /// must have that category: `SetNull` would leave a row whose `target` says CATEGORY with
  /// nowhere to go, which is the exact state the constraint exists to make impossible. The cost is
  /// real and worth naming — deleting a category takes its poster with it — and it is the same
  /// answer this schema already gives for a subcategory outliving its parent.
  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// `http` or `https` only, bounded by BANNER_URL_MAX_LENGTH. It is echoed verbatim into an
  /// anchor on the anonymous, indexed shop window, which is why the scheme is an allow-list rather
  /// than a deny-list — the same rule `store-fields.dto.ts` states for every other stored URL.
  externalUrl String?

  /// The order the shopkeeper chose. Ties break on title so the page is never arbitrary.
  position Int     @default(0)
  /// Hiding a banner keeps it. It is not a delete, and the picture is not re-uploaded to undo it.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The storefront's read, in one index scan.
  @@index([storeId, isActive, position])
  @@map("store_banners")
}
