/// A shop's affiliate programme (IMPULSEIA-101, plan docs/plans/2026-10-24--afiliados.md): its rules.
/// One row per shop, written with its default table the first time the owner opens the programme,
/// switched off. A change applies from then on: an order keeps the rates it was placed at.
model AffiliateProgram {
  storeId String @id @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  enabled         Boolean @default(false)
  /// Days a visit through an affiliate's link credits the orders that follow it, 1 to 90, by a CHECK.
  attributionDays Int     @default(30)
  /// Days after a payout period closes that its commissions fall due, 0 to 60, by a CHECK.
  payoutDelayDays Int     @default(10)
  /// The shop's own terms, which an affiliate accepts on joining; null when there are none.
  termsText       String?
  /// 0 until terms are first written; up by one each time their text changes, removal included.
  termsVersion    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("affiliate_programs")
}

/// A commission table: one rate for every product, and a product's own where it has one. Every
/// affiliate is on one; a special condition is another table. The default table is born with the
/// programme and never deleted — one per shop, by the partial unique index the migration adds.
/// Deleting a table touches no history: an order keeps the table's name and each line's rate.
model CommissionTable {
  id             String  @id @default(uuid(7)) @db.Uuid
  storeId        String  @db.Uuid
  store          Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String  @db.VarChar(60)
  /// Basis points of what the customer paid for a product, 0 to 10000, by a CHECK.
  defaultRateBps Int
  isDefault      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates      CommissionTableRate[]
  affiliates Affiliate[]

  @@unique([storeId, name])
  /// One default table per shop, however many first readings open the programme at once.
  @@unique([storeId], where: { isDefault: true }, map: "commission_tables_one_default_key")
  @@map("commission_tables")
}

/// A product's own rate on a table, which replaces the table's for that product; 0 pays it nothing.
/// Deleting the product, or the table, takes it along.
model CommissionTableRate {
  tableId   String          @db.Uuid
  table     CommissionTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Basis points, 0 to 10000, by a CHECK.
  rateBps   Int

  updatedAt DateTime @updatedAt

  @@id([tableId, productId])
  @@index([productId])
  @@map("commission_table_rates")
}

/// Where an affiliate stands with a shop (IMPULSEIA-103). INVITED until the invite is accepted;
/// ACTIVE ⇄ PAUSED; ENDED for good — the same e-mail may be invited again, as a new row.
enum AffiliateStatus {
  INVITED
  ACTIVE
  PAUSED
  ENDED
}

/// Someone who sells through a shop's link (plan docs/plans/2026-10-24--afiliados.md): one row per
/// standing with one shop. The account is bee-link's own (storeId null), never the shop's, so one
/// account sells for many shops. E-mail and account are unique in the shop among the rows not ended;
/// the `/name` is unique in the shop for good, so a printed link of an ended affiliate never credits
/// someone else.
model Affiliate {
  id      String          @id @default(uuid(7)) @db.Uuid
  storeId String          @db.Uuid
  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Null until the invite is accepted, and again if the account is deleted.
  userId  String?         @db.Uuid
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name    String          @db.VarChar(120)
  /// Lower case, as invited: the one address whose account may accept.
  email   String          @db.VarChar(254)
  /// Digits only, with the country code.
  phone   String?         @db.VarChar(20)
  /// The shop's own; the affiliate never reads it.
  note    String?         @db.VarChar(500)
  /// The `/name`, normalised as a category slug is; null while invited.
  slug    String?         @db.VarChar(40)
  status  AffiliateStatus @default(INVITED)
  /// A table with an affiliate who has not ended is not deleted; one with only ended ones hands them
  /// to the default table first, so the key never dangles. NO ACTION rather than RESTRICT: checked at
  /// the end of the statement, so a shop deleted takes its tables and its affiliates together.
  tableId String          @db.Uuid
  table   CommissionTable @relation(fields: [tableId], references: [id], onDelete: NoAction)
  /// As the affiliate gave it, up to 140 characters; the shop pays through it, outside bee-link.
  pixKey  String?         @db.VarChar(140)
  /// What the shop window shows of them (AF5); edited in their own area (AF8).
  photoUrl String?
  tagline  String?        @db.VarChar(100)
  /// The shop's terms as accepted: their version, and when.
  termsVersion    Int?
  termsAcceptedAt DateTime?

  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// What the shop owes them (IMPULSEIA-106), read again from their commissions and their statement
  /// under their row's lock at every change: `pendingCents`, what waits on a delivery or a due day —
  /// 0 or more, by a CHECK; `availableCents`, the statement's sum, which may go below zero.
  pendingCents   Int @default(0)
  availableCents Int @default(0)

  invite AffiliateInvite?
  /// Visits through their link, a number a day (IMPULSEIA-105).
  visitDays AffiliateVisitDay[]
  /// The orders credited to them, their commissions and their statement (IMPULSEIA-106).
  orders      Order[]
  commissions AffiliateCommission[]
  entries     AffiliateEntry[]
  /// What the shop paid them outside bee-link, and the orders moved to or away from them (IMPULSEIA-107).
  payouts      AffiliatePayout[]
  changesFrom  AffiliateAttributionChange[] @relation("AffiliateChangeFrom")
  changesTo    AffiliateAttributionChange[] @relation("AffiliateChangeTo")

  @@unique([storeId, slug])
  @@unique([storeId, email], where: raw("(status <> 'ENDED'::\"AffiliateStatus\")"), map: "affiliates_live_email_key")
  @@unique([storeId, userId], where: raw("(status <> 'ENDED'::\"AffiliateStatus\") AND (\"userId\" IS NOT NULL)"), map: "affiliates_live_user_key")
  /// The shop's list, newest invited first, by status.
  @@index([storeId, status, invitedAt])
  @@index([tableId])
  @@index([userId])
  @@map("affiliates")
}

/// The invite of an affiliate still INVITED: one per affiliate. Sending it again replaces the token
/// and the expiry, so only the latest e-mail's link works. Only the token's SHA-256 is kept.
model AffiliateInvite {
  affiliateId String    @id @db.Uuid
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime
  sentAt      DateTime
  usedAt      DateTime?

  @@map("affiliate_invites")
}

/// One affiliate's visits through their link on one day (IMPULSEIA-105, decision 10 of the epic): a
/// number, and nothing of who. Written by one statement, `INSERT … ON CONFLICT … visits + 1`, never
/// read first, like `StoreFunnelDay`; days older than thirteen months go with the funnel's
/// (`reports/funnel-retention.ts`).
model AffiliateVisitDay {
  affiliateId String    @db.Uuid
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// The affiliate's shop, repeated so the shop's own reads go by it without a join.
  storeId     String    @db.Uuid
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// The day on the shop's clock (Brasília, a fixed -03:00), decided by the API when the visit arrives.
  day         DateTime  @db.Date
  visits      Int       @default(0)

  @@id([affiliateId, day])
  @@index([storeId, day])
  /// The retention's delete reads by day alone.
  @@index([day])
  @@map("affiliate_visit_days")
}

/// Where an order's commission stands (IMPULSEIA-106). PENDING waits on the delivery and then on its
/// due day; AVAILABLE is owed from that day; REVERSED is undone by a cancellation, for good. An order
/// that leaves *delivered* waits again.
enum AffiliateCommissionStatus {
  PENDING
  AVAILABLE
  REVERSED
}

/// Why an attributed order's commission is nothing.
enum AffiliateCommissionZeroReason {
  /// The customer's e-mail or phone was the affiliate's own.
  OWN_PURCHASE
}

/// What a line of an affiliate's statement records. A line is never edited: a mistake is answered by
/// another line. ADJUSTED and PAID_OUT are the shop's, written by its money screens (AF7).
enum AffiliateEntryKind {
  /// A commission fell due.
  RELEASED
  /// A commission taken back after it had fallen due: its order cancelled, or out of *delivered*.
  REVERSED
  ADJUSTED
  PAID_OUT
}

/// What an order owes the affiliate it was credited to (IMPULSEIA-106): its state, one per order.
/// Worked out when the order is placed, at the affiliate's table then, and never again: the table's
/// name and each line's rate are kept, so a table changed or deleted later rewrites nothing.
model AffiliateCommission {
  orderId     String                         @id @db.Uuid
  order       Order                          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The order's shop, repeated so the shop's own reads go by it without a join.
  storeId     String                         @db.Uuid
  store       Store                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  affiliateId String                         @db.Uuid
  affiliate   Affiliate                      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  status      AffiliateCommissionStatus      @default(PENDING)
  /// What the customer paid for the products, never the delivery: the base the rates were taken of.
  baseCents       Int
  /// 0 or more, by a CHECK; 0 for an own purchase, or for products whose rates are 0.
  commissionCents Int
  /// The table's name as it was when the order was placed.
  tableName       String                     @db.VarChar(60)
  zeroReason      AffiliateCommissionZeroReason?
  /// The day it falls due: the due day of the payout period of the delivery's day, at the programme's
  /// delay then. Null until delivered, and again once the order leaves *delivered*.
  dueOn           DateTime?                  @db.Date
  /// When it fell due; null while pending.
  availableAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines AffiliateCommissionLine[]

  /// The sweep: what is due by today.
  @@index([status, dueOn])
  /// The affiliate's reads, and what a shop owes each by due day (AF7).
  @@index([affiliateId, status, dueOn])
  @@index([storeId, status, dueOn])
  @@map("affiliate_commissions")
}

/// One line of an order's commission: what the line took of the base, at its rate then.
model AffiliateCommissionLine {
  orderItemId     String              @id @db.Uuid
  orderItem       OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderId         String              @db.Uuid
  commission      AffiliateCommission @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  /// Basis points, 0 to 10000, by a CHECK: the product's own on the table, else the table's.
  rateBps         Int
  baseCents       Int
  commissionCents Int

  @@index([orderId])
  @@map("affiliate_commission_lines")
}

/// One line of an affiliate's statement (IMPULSEIA-106). Only ever inserted. Its amounts add up to the
/// affiliate's available balance, which may go below zero: a commission taken back after it was paid
/// is what the next payment is short by.
model AffiliateEntry {
  id          String             @id @default(uuid(7)) @db.Uuid
  storeId     String             @db.Uuid
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  affiliateId String             @db.Uuid
  affiliate   Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  kind        AffiliateEntryKind
  /// Signed, never 0, by a CHECK.
  amountCents Int
  /// The order whose commission it moved; null for the shop's own lines (AF7).
  orderId     String?            @db.Uuid
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// The shop's words, on an ADJUSTED — required there, by a CHECK. The affiliate reads it too.
  reason      String?            @db.VarChar(200)
  /// Who wrote an ADJUSTED or a PAID_OUT (IMPULSEIA-107); null for the clock's lines.
  actorId     String?            @db.Uuid
  actor       User?              @relation("AffiliateEntryActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// The payment a PAID_OUT records — one line per payment, and one on every PAID_OUT, by a CHECK.
  payoutId    String?            @unique @db.Uuid
  payout      AffiliatePayout?   @relation(fields: [payoutId], references: [id], onDelete: NoAction)
  createdAt   DateTime           @default(now())

  /// The statement, newest first.
  @@index([affiliateId, createdAt])
  @@index([orderId])
  @@map("affiliate_entries")
}

/// The e-mails an affiliate's sales owe (IMPULSEIA-106): one when an order is credited to them, one
/// when such an order is cancelled — one of each per order, by the unique index. An outbox: written by
/// the transaction that owes it, sent by `AffiliateSaleMailer` on its own clock.
enum AffiliateSaleNoticeKind {
  SALE
  CANCELLED
}

model AffiliateSaleNotice {
  id            String                  @id @default(uuid(7)) @db.Uuid
  orderId       String                  @db.Uuid
  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind          AffiliateSaleNoticeKind
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now())
  sentAt        DateTime?
  createdAt     DateTime                @default(now())

  @@unique([orderId, kind])
  /// What the outbox claims: owed and due.
  @@index([sentAt, nextAttemptAt])
  @@map("affiliate_sale_notices")
}

/// How a payment made outside bee-link went (IMPULSEIA-107).
enum AffiliatePayoutMethod {
  PIX
  TRANSFER
  CASH
}

/// A payment the shop made to an affiliate outside bee-link, recorded (IMPULSEIA-107, decision 9 of
/// the epic): nothing moves here. Its PAID_OUT line takes it off the statement; never edited nor
/// deleted — a mistake is answered by an adjustment.
model AffiliatePayout {
  id          String                @id @default(uuid(7)) @db.Uuid
  storeId     String                @db.Uuid
  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  affiliateId String                @db.Uuid
  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// 1 or more, by a CHECK.
  amountCents Int
  /// The day the shop paid, on its calendar.
  paidOn      DateTime              @db.Date
  method      AffiliatePayoutMethod
  note        String?               @db.VarChar(200)
  createdById String?               @db.Uuid
  createdBy   User?                 @relation("AffiliatePayoutAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  entry AffiliateEntry?

  @@index([affiliateId, paidOn])
  @@map("affiliate_payouts")
}

/// The shopkeeper moving an order to another affiliate, or off its own, while its commission was
/// pending (IMPULSEIA-107, decision 7 of the epic): the order's history of whom it was credited to.
/// The names are kept as they were, so the line reads the same whatever becomes of either.
model AffiliateAttributionChange {
  id              String     @id @default(uuid(7)) @db.Uuid
  orderId         String     @db.Uuid
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId         String     @db.Uuid
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Null when the order was credited to nobody before.
  fromAffiliateId String?    @db.Uuid
  fromAffiliate   Affiliate? @relation("AffiliateChangeFrom", fields: [fromAffiliateId], references: [id], onDelete: SetNull)
  fromName        String?    @db.VarChar(120)
  /// Null when it was taken off its affiliate.
  toAffiliateId   String?    @db.Uuid
  toAffiliate     Affiliate? @relation("AffiliateChangeTo", fields: [toAffiliateId], references: [id], onDelete: SetNull)
  toName          String?    @db.VarChar(120)
  reason          String     @db.VarChar(200)
  actorId         String?    @db.Uuid
  actor           User?      @relation("AffiliateChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())

  @@index([orderId, createdAt])
  @@map("affiliate_attribution_changes")
}
