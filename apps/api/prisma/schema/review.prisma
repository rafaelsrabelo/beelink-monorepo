/// A product's review, by a customer the shop delivered it to (BEELINK-156): one per customer and
/// product, which they may edit. Published unless the shopkeeper hid it; the product keeps the
/// published ones' count and rating sum as a cache (`reviewCount`, `reviewRatingSum`), moved by every
/// write here in the same transaction.
model ProductReview {
  id         String          @id @default(uuid(7)) @db.Uuid
  /// The product's shop, repeated for the panel's list.
  storeId    String          @db.Uuid
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String          @db.Uuid
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String          @db.Uuid
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The combination bought — in the latest delivered order with the product, by when it was placed — and
  /// its label as the order line kept it, which outlives the combination.
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?         @db.VarChar(320)
  /// The delivered order that let the customer review: a bought and received product.
  orderId      String?         @db.Uuid
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// 1 to 5, by a CHECK in the migration.
  rating  Int
  /// Up to 1000 characters; null is a rating alone.
  comment String? @db.VarChar(1000)
  /// When the shopkeeper hid it; null is published. Only the shopkeeper moves it — the customer's
  /// edit does not publish what the shop took down.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  /// The customer's last edit: hiding, publishing and a merge keep it.
  updatedAt DateTime  @updatedAt

  @@unique([customerId, productId])
  /// The shop window's page of a product's published reviews, the most recent first.
  @@index([productId, hiddenAt, createdAt(sort: Desc)])
  /// The panel's list, the most recent first.
  @@index([storeId, createdAt(sort: Desc)])
  /// For the SetNull when a combination or an order goes: without them, each deleted row scans the table.
  @@index([variantId])
  @@index([orderId])
  @@map("product_reviews")
}
