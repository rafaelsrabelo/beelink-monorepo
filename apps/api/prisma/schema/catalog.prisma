/// Whether a product is on sale or still being written.
///
/// It replaced a boolean called `available`, which conflated two facts a shopkeeper keeps apart: a
/// draft was never published, and something out of stock was. The boolean made them one row state,
/// so the screen could not say which of the two a hidden product was — and the shopkeeper went
/// looking for a missing product in the wrong place.
///
/// ACTIVE is what the shopkeeper intends; DRAFT is visible to nobody but its owner.
///
/// It is not the whole of what a visitor sees. Being on the shelf is ACTIVE **and** not sold out,
/// and the two are kept apart because they answer different questions: status is an intention, and
/// stock is a fact. A product can be a draft and sold out at once. The one place that combines them
/// is `src/modules/catalog/catalog.visibility.ts`, and every public query goes through it.
enum ProductStatus {
  ACTIVE
  DRAFT
}

/// Whether the shop makes the thing or buys it to resell.
///
/// Not the manufacturer's *name*: a name is free text, and free text means `Nike`, `NIKE` and
/// `nike` are three brands in the filter a month later. The question a shopkeeper actually asks of
/// this field is which of their products they produce, and that question has two answers.
///
/// Nullable, and null is not a third kind of product — it is a shopkeeper who has not said yet.
/// Defaulting it would print an answer they never gave onto every row written before the column
/// existed.
enum ProductOrigin {
  IN_HOUSE
  RESALE
}

/// The shopkeeper's own taxonomy of what they sell, and the second segment of a public URL:
/// `/lessari/blusas`. Not `StoreCategory`, which is the platform's taxonomy of shops.
model ProductCategory {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Unique inside the shop and nowhere else: two shops both selling `blusas` is the normal case,
  /// and a platform-wide unique would make the hundredth shop's onboarding a scavenger hunt.
  /// Stored already normalised by `src/shared/slug.ts`, the same function the shop's own slug and
  /// the design system use, so the unique index means what it says without a case-insensitive
  /// collation. The API refuses a value in RESERVED_PATH_SEGMENTS: a category on `produtos` would
  /// be unreachable, because the segment is read as a route word before it is looked up here.
  slug String @db.VarChar(80)
  name String @db.VarChar(120)

  description String?
  imageUrl    String?

  /// The category this one sits under. Null is a top level.
  ///
  /// Exactly two levels deep, and the service refuses a third: the URL is `/<shop>/<category>` flat,
  /// so a grandchild would either need a second segment the router has no room for, or share the
  /// namespace with its grandparent and be indistinguishable from it. Two levels is also what a
  /// shopkeeper actually fills in — "Proteínas → Whey" — and a tree nobody prunes is a menu nobody
  /// can read.
  ///
  /// Cascade, because a subcategory outliving its parent is a category with a parent that is not
  /// there, and the storefront would have to invent a place to show it.
  parentId String?           @db.Uuid
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProductCategory[] @relation("CategoryTree")

  /// The order the shopkeeper chose. The storefront shows them in it, because the shopkeeper knows
  /// what they want to sell first. Ties break on name so the list is never arbitrary.
  position Int     @default(0)
  /// Hiding a category keeps its products. It is not a delete, and the products stay reachable at
  /// their own URLs.
  isActive Boolean @default(true)

  /// Every slug this category has answered to before, oldest first, bounded at 10 by the service.
  /// A column and not a `SlugRedirect` table because that table's target would be polymorphic — a
  /// product or a category — which Prisma cannot constrain, so it would buy a discriminator, a
  /// second cascade and a join on the cold path in exchange for a `createdAt` nobody reads. Here
  /// the redirect lookup folds into the same query that does the live one, and it cascades free.
  slugHistory String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  /// The showcases that draw this category. Deleting the category leaves them asking for another.
  showcases StoreComponent[]

  @@unique([storeId, slug])
  /// The storefront's category list, in one index scan.
  @@index([storeId, isActive, position])
  /// One parent's children, which is what a category page asks for.
  @@index([parentId, isActive, position])
  @@map("product_categories")
}

/// One thing a shop sells. Its URL is `/<shop>/<product word>/<slug>` and never nests under a
/// category: a product in two categories would otherwise have two URLs, and re-categorising one
/// would break every link already shared.
model Product {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// SetNull, not Cascade: retiring a category must never delete what was in it.
  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Normalised exactly as a category slug is, by the same function. A product and a category may
  /// share a slug — they live at different depths, so no URL is ambiguous.
  slug String @db.VarChar(120)
  name String @db.VarChar(160)

  description String?

  // From here to `heightMm`, every per-unit column is a cache of the product's variants, written
  // by the API whenever a variant changes and never on its own. See ProductVariant.

  /// Whole cents, and the `Cents` suffix is here so the ambiguity cannot return by inattention.
  /// The legacy kept reais, cents and "R$ 25,00" in one column and chose between them with
  /// `if (price < 1000)`, which is why a product could be sold for a hundredth of its price.
  priceCents          Int
  /// What the price was before. Null means no discount; the percentage is computed where it is
  /// rendered rather than stored, so a stored percentage can never disagree with the two numbers
  /// it was derived from. The API refuses a value at or below `priceCents`.
  compareAtPriceCents Int?
  /// The dearest variant a customer can order, beside `priceCents` as the cheapest, so a card can
  /// say "R$ 69,90 – R$ 209,90" without reading a product's variants. Part of the cache.
  maxPriceCents       Int

  position Int            @default(0)
  /// See ProductStatus. Only ACTIVE rows leave this table for the shop window.
  status   ProductStatus  @default(ACTIVE)
  /// See ProductOrigin. Null means the shopkeeper has not said.
  origin   ProductOrigin?

  /// What the shopkeeper paid for it. Only they ever see it: it is here so a margin can be shown
  /// beside the price, and it must never reach `PublicProduct`.
  costCents Int?

  /// The shopkeeper's own code for the thing. Unique within a shop, but that is enforced on
  /// ProductVariant, which owns the code: this column is part of the cache described there.
  sku     String? @db.VarChar(64)
  /// EAN, UPC or whatever is printed on the box. A string and not a number: leading zeros matter.
  barcode String? @db.VarChar(64)

  /// Whether this shop counts this product. Off by default, because most shops here sell made to
  /// order, and a shop that does not count is never sold out however empty the column below is.
  trackStock    Boolean @default(false)
  /// How many are left, and read only when `trackStock`. Nullable rather than zero so "not counted"
  /// and "none left" stay different facts. On a counted product, null and zero mean the same thing
  /// — a shopkeeper who turned counting on and has not said how many, which from the shelf is none.
  ///
  /// Reaching zero takes the product out of the grid, the category and the search, and leaves its
  /// own page answering, marked sold out, with no way to order. See catalog.visibility.ts.
  stockQuantity Int?

  /// Grams, and integers. Melhor Envio quotes on weight and size, and this is the field the quote
  /// reads — a shipping integration that has to ask the shopkeeper for a weight at checkout is a
  /// shipping integration nobody finishes. Null until they fill it in; the quote refuses then,
  /// which is a better failure than guessing a box.
  weightGrams Int?
  /// Millimetres, integers, of the parcel rather than the product — which is what a carrier
  /// measures. All three or none; the API refuses a partial set.
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?

  /// See ProductCategory.slugHistory. A product slug is derived from a name the shopkeeper will
  /// fix within the hour, and these links are shared on WhatsApp, where a 404 is the most visible
  /// failure this product can produce.
  slugHistory String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   ProductImage[]
  options  ProductOption[]
  variants ProductVariant[]

  @@unique([storeId, slug])
  /// Two shapes of read, two indexes: the whole shop's grid, and one category's.
  @@index([storeId, status, position])
  @@index([categoryId, status, position])
  /// A NEWEST showcase: the shop's products on the shelf, most recently created first.
  @@index([storeId, status, createdAt])
  @@map("products")
}

/// A product's photos, in the order the shopkeeper arranged them. There is no `isPrimary` flag:
/// the first row is the card's image, which cannot be two rows at once and so needs no partial
/// unique index to defend it — the legacy used a trigger that rewrote the other rows instead of
/// refusing the wrong write.
model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The stored URL. The bytes go to Cloudinary through `modules/uploads`; nothing here holds them.
  url String
  /// What a screen reader says. Null falls back to the product's name where it is rendered — never
  /// to the file name, which is what an empty alt attribute effectively announces.
  alt String? @db.VarChar(200)

  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

/// A choice the customer makes before ordering — Tamanho, Cor, Sabor. At most three per product,
/// which a trigger in the migration enforces: every combination of values is a variant, and three
/// options of five values each is already 125 rows for a shopkeeper to price.
model ProductOption {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String @db.VarChar(40)
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values        ProductOptionValue[]
  variantValues ProductVariantValue[]

  @@index([productId, position])
  @@map("product_options")
}

/// One answer to an option — P, Areia, Frutas vermelhas.
model ProductOptionValue {
  id       String        @id @default(uuid(7)) @db.Uuid
  optionId String        @db.Uuid
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  name     String  @db.VarChar(60)
  /// A colour option's swatch, as `#rrggbb`. Data the shopkeeper chose, applied at runtime — the
  /// same exception a shop's brand colour is. Null on every value of an option that is not a colour.
  colorHex String? @db.VarChar(7)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantValues ProductVariantValue[]

  /// Only so a variant's value can be required to belong to the option it is filed under.
  @@unique([optionId, id])
  @@index([optionId, position])
  @@map("product_option_values")
}

/// One thing that can actually be ordered: a product with one value of each of its options picked.
/// A product with no options still has exactly one — its default variant, with no values — so a
/// price and a stock always belong to a variant, and an order always names one.
///
/// Product keeps its per-unit columns as a cache of these rows, recomputed by the API on every
/// write: the cheapest variant on sale sets the price the grid shows, the stock is the sum of what
/// is on sale, and the codes, weight and box come from the first variant on sale. That is what lets
/// the shelf rule, the showcases and the cards keep reading one table.
model ProductVariant {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The product's shop, repeated here only so the SKU below can be unique per shop.
  storeId   String  @db.Uuid
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  position Int     @default(0)
  /// Whether this combination is sold at all. Off is "não vendo esta" — a combination that does
  /// not exist — and is different from sold out, which is a counted variant at zero.
  isActive Boolean @default(true)

  /// Same meaning and rules as the column of the same name on Product.
  priceCents          Int
  compareAtPriceCents Int?
  costCents           Int?

  /// Unique within the shop, so an order line, a restock request or a spreadsheet can name one
  /// variant by it. Null is not a code, and any number of variants may have none.
  sku     String? @db.VarChar(64)
  barcode String? @db.VarChar(64)

  trackStock    Boolean @default(false)
  stockQuantity Int?

  weightGrams Int?
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?

  /// A URL rather than a ProductImage id: the gallery is replaced whole on every save, which gives
  /// every image a new id, and a foreign key to one would be cut by the next unrelated edit.
  imageUrl String?

  /// Set when the variant's combination stopped existing — a value or an option was removed. The
  /// row stays, so an order that named it keeps something to point at; its SKU is released so the
  /// code can be given to what replaced it. Every read and the product's cache skip archived rows.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ProductVariantValue[]

  @@unique([storeId, sku])
  @@index([productId, position])
  @@map("product_variants")
}

/// Which value of each option a variant is. The key is the variant and the option, so a variant
/// holds at most one value of each; the option is repeated beside the value for that reason, and
/// the value's key includes it, so a value can only be filed under its own option.
model ProductVariantValue {
  variantId String             @db.Uuid
  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String             @db.Uuid
  option    ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  valueId   String             @db.Uuid
  value     ProductOptionValue @relation(fields: [optionId, valueId], references: [optionId, id], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([valueId])
  @@map("product_variant_values")
}
