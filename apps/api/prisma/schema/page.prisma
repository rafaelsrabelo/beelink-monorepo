/// What a component is.
///
/// A closed list, and it closed before the first row was written. The seventh kind is a value here,
/// a shape in the zod union, a component with a story and a test, and a panel of fields — the build
/// breaks at every point that is missing, which is the reason this is an enum and not a string.
///
/// There is no HERO, and its absence is the point of this shape. A cover used to be a kind, meaning
/// "this banner is the one at the top" — a position turned into a type. A cover is a full-width
/// section that happens to come first, holding a banner. A design that REMOVES a special case
/// rather than adding one is the one to take; the same sign retired `belowProducts`.
enum ComponentKind {
  /// The strip above the header. The one component not drawn where its section sits: it is above
  /// the masthead on every page, so "before the header" is not a position an arrangement can hold.
  ANNOUNCEMENT
  /// A picture, or several, which makes it a carousel. It may point somewhere.
  BANNER
  /// A heading and the line under it. A sign, not a card.
  HEADING
  /// A paragraph. Its own kind and not a mode of the heading: a form with a mode is two forms.
  TEXT
  /// The band of promises: an icon, a title and a line, per row.
  BENEFITS
  /// The shop's categories, as a grid of cards.
  CATEGORIES
  /// A showcase of what the shop sells, drawn from its `source`. As many as the shop wants; the
  /// last one cannot be deleted.
  PRODUCTS
  /// A form a visitor fills in, beside the ways to reach the owner. Its `items` are the fields;
  /// what arrives through it is a `Lead`. A site's kind — a shop takes orders, not contact.
  CONTACT
  /// Questions and their answers, in `items`. Drawn as an accordion whose answers are in the page.
  FAQ
  /// A title, a line of text and one button, in `items`, that leads somewhere.
  CALL_TO_ACTION
  /// A picture beside a title and a paragraph; the picture and an optional button are its `items`.
  IMAGE_TEXT
  /// One product, large, resolved when the page is read; its pick is its `items`.
  FEATURED_PRODUCT
}

/// How wide a section sits on the page. It belongs to the band and not to what is inside it, which
/// is why a cover no longer needs a kind: a full-bleed band is a section that bleeds, whatever it
/// holds.
enum SectionWidth {
  FULL
  CONTAINED
}

/// Where a component's words sit. Read on HEADING and TEXT. The column is nullable, and null is
/// not a fourth value: it is "as this kind always drew it" — a heading centred, a paragraph at the
/// left — which no single column default could say for both.
enum TextAlign {
  LEFT
  CENTER
  RIGHT
}

/// How much of its band a component takes. The band's own width is `SectionWidth`; this is the
/// block's slice of it, and the choice the size picker always meant.
///
/// It was `layout`, which also chose the grid a banner's slides sat in, so "um terço" drew a
/// third-wide cell and a band of three slides drew full width whatever was picked. The width is the
/// only one of those meanings the shopkeeper reads in the words, so it is the one that got a column.
enum ComponentSpan {
  FULL
  HALF
  THIRD
  TWO_THIRDS
}

/// How a component with several things in it lays them out. A banner's pictures take turns
/// (CAROUSEL) or share the space (GRID); a showcase's products scroll on one row (RAIL) or wrap into
/// rows (GRID). A carousel and a rail are not the same thing: one shows a single picture at a time,
/// the other shows as many cards as fit and lets the rest scroll.
enum ComponentDisplay {
  CAROUSEL
  GRID
  RAIL
  BACKDROP
  SPLIT
  CHIPS
  INLINE
  CARDS
  STATIC
  MARQUEE
  /// A FAQ's only layout, named so a second one is a value and not a migration of the rows.
  ACCORDION
  /// A strip of the shop's colour, edge to edge. A call to action's.
  BAND
  /// One tinted card inside the page's margins — not `CARDS`, the benefits' many. A call to action's.
  CARD
  /// The picture on the left of the words, or on their right. An image with text's.
  IMAGE_LEFT
  IMAGE_RIGHT
  /// The picture wide and the words under it. A featured product's.
  IMAGE_LARGE
}

/// Where a component shows. The shop window's `md` width is the line between a phone and a computer.
enum DeviceVisibility {
  ALL
  DESKTOP
  PHONE
}

/// Which products a showcase draws.
///
/// There is no best sellers: nothing records a sale yet, and a source named for sales would draw
/// some other order under that name. It is one value added the day orders exist.
enum ProductSource {
  /// Everything on the shelf, in the shopkeeper's order.
  ALL
  /// One category and its subcategories. The category is `sourceCategoryId`.
  CATEGORY
  /// The products the shopkeeper picked, in the order they picked them. They are the `items`.
  SELECTION
  /// The most recently created first.
  NEWEST
  /// The ones with a "was" price.
  ON_SALE
}

/// Which page it is: the shop's home at /<shop>, or a landing page at /<shop>/lp/<address>.
enum PageKind {
  HOME
  LANDING
}

/// Whether a landing page is served. The home is always published.
enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A page of a shop, made of bands: its home, and the landing pages it builds for a launch or a promotion.
///
/// The header and the footer are the shop's, drawn from its home, on every page; a landing only says
/// whether it draws them at all.
model StorePage {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  kind PageKind @default(LANDING)

  /// Where a landing lives, after /lp/. Null on the home, and only there (a CHECK in the migration).
  slug String? @db.VarChar(60)

  /// The page's name in the panel, and its title where it has no SEO title of its own.
  title String @db.VarChar(80)

  /// Whether the shop's header, footer and strip frame it. A landing without them is a page of its own.
  usesChrome Boolean @default(true)

  /// Whether it is linked from the shop's menu and footer. Read only while it is published.
  inMenu Boolean @default(false)

  seoTitle       String? @db.VarChar(70)
  seoDescription String? @db.VarChar(160)
  seoImageUrl    String?

  status      PageStatus @default(DRAFT)
  publishedAt DateTime?

  /// One more on every accepted write to the page's draft — its bands and blocks — and never on a
  /// refused one. A write that names the revision it read is refused (409) when another landed since.
  draftRevision Int @default(0)

  sections StoreSection[]
  /// Every time it was published, frozen. The newest is what the shop serves.
  versions StorePageVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId], where: raw("\"kind\" = 'HOME'"), map: "store_pages_one_home_key")
  @@index([storeId, status, inMenu])
  @@map("store_pages")
}

/// One band of a shop's landing page.
///
/// The level the shopkeeper asked for in their own words — "seção tem atributos (cores, ordenação)
/// e tem componentes". A flat list of blocks could not say two things they needed: that a heading
/// belongs to the shelf under it, and that a band has a background of its own. Neither is
/// expressible when the only relation between two blocks is that they happen to be adjacent.
model StoreSection {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// The page it is a band of. The shop's is kept too, for the ownership every query here starts with.
  pageId String    @db.Uuid
  page   StorePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// What the band is called on the page, if named. On a site the named bands are the menu.
  name String? @db.VarChar(60)

  /// Edge to edge, or inside the page's measure.
  width SectionWidth @default(CONTAINED)

  /// This band's own colour. Null is the page's. Whatever is written on it is derived from it by
  /// the same rule the rest of the shop window uses, so a dark band in a pale shop is readable
  /// without anyone choosing a text colour.
  background String? @db.VarChar(9)

  /// The band's place on the page. A component's place inside it is the component's.
  position Int @default(0)

  /// Hiding a band hides everything in it, and keeps all of it.
  isActive Boolean @default(true)

  components StoreComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A page's read, in one index scan; and the shop's, for the ownership checks and the cascade.
  @@index([pageId, isActive, position])
  @@index([storeId])
  @@map("store_sections")
}

/// One thing inside a band.
///
/// A table and not JSON on the section, because a component has to be addressable: the editor
/// hides one, reorders one and deletes one, and a row is what makes each of those a single write
/// instead of a read-modify-write of the whole band.
///
/// It points nowhere itself, and that is a column count this model DROPPED. Four columns and a
/// CHECK used to say where a poster sent a visitor — and after a banner became one component
/// holding slides, the destination moved into the slide and nothing read them again. A column with
/// no reader is the `layoutSettings` disease, sixteen keys of which survived years unread here.
model StoreComponent {
  id        String       @id @default(uuid(7)) @db.Uuid
  sectionId String       @db.Uuid
  section   StoreSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  /// Kept beside the section's, denormalised on purpose: every query this module runs is scoped to
  /// one shop, and the alternative is a join on the page a stranger asks for first.
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  kind ComponentKind

  title    String? @db.VarChar(120)
  subtitle String? @db.VarChar(200)
  /// The paragraph, on a TEXT. Null on every other kind.
  body     String?

  /// Its slice of the band, on every kind.
  span ComponentSpan @default(FULL)

  /// Read on BANNER, PRODUCTS and CATEGORIES, each with its own two values. Null on every other kind.
  display ComponentDisplay?

  /// What a showcase draws. Read on PRODUCTS, null on every other kind.
  source ProductSource?

  /// The category a CATEGORY showcase draws, and null for every other source. A category deleted
  /// under it leaves the showcase asking for one rather than taking it down.
  sourceCategoryId String?          @db.Uuid
  sourceCategory   ProductCategory? @relation(fields: [sourceCategoryId], references: [id], onDelete: SetNull)

  /// How many products a showcase draws, at most. Null is 24, what the landing page drew before a
  /// shop could have more than one.
  limit Int?

  /// How many across a grid draws. Read on CATEGORIES and PRODUCTS.
  columns Int?

  /// Read on HEADING and TEXT. Null keeps the kind's own habit.
  align TextAlign?

  /// Where it shows. A band shows wherever one of its components does, so it has no column of its own.
  visibleOn DeviceVisibility @default(ALL)

  /// A banner's slides, or a benefits band's rows. Empty on every other kind.
  ///
  /// Json, and the difference from `layoutSettings` is the one that matters: this is content.
  /// Sixteen of that blob's twenty-one keys survived years unread because a key nobody draws is
  /// invisible; an `items` nobody draws is a blank band on the front page, reported the same day.
  items Json @default("[]")

  /// Its place inside its section.
  position Int @default(0)

  isActive Boolean @default(true)

  /// What arrived through this component, when it is a CONTACT form.
  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, position])
  @@index([storeId, kind])
  @@map("store_components")
}

/// A page as it was published: its bands and blocks, frozen in `document`. Never updated.
///
/// The newest by `number` is the one the shop serves — there is no pointer to it: history is
/// append-only and restoring never publishes, so the newest is always the live one. What the
/// shopkeeper edits is the rows in `store_sections` and `store_components`, the draft; a visitor is
/// served this. Products, prices and stock are still resolved when the page is read.
model StorePageVersion {
  id      String    @id @default(uuid(7)) @db.Uuid
  pageId  String    @db.Uuid
  page    StorePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Denormalised, as the bands' is: the shop's read of its home selects it through the shop.
  storeId String    @db.Uuid
  store   Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// 1, 2, 3… per page. A number and not the time, because two clocks can tie.
  number   Int
  /// `{ format, sections }`: see `page-document.ts`. Hidden bands and blocks included, so a restore loses nothing.
  document Json
  note     String? @db.VarChar(140)

  /// Who published it. SetNull: a version outlives the account that made it.
  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([pageId, number])
  @@index([storeId])
  @@map("store_page_versions")
}
