/// A product a shopper liked at a shop (BEELINK-153), with what it cost then, so the shop can say it
/// got cheaper. One per product: a heart on a card likes the product as a whole and cannot tell two
/// rows of one product apart; the product's page may name the combination chosen there.
///
/// The shop is the customer's; the product is checked to be the same shop's when it is liked.
model CustomerFavorite {
  id         String          @id @default(uuid(7)) @db.Uuid
  customerId String          @db.Uuid
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String          @db.Uuid
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The combination chosen on the product's page; null for the product as a whole. A combination
  /// that stops existing is archived, never deleted, and is ignored where the favourite is read.
  /// NoAction and not SetNull: a null here would pass for a like of the whole product, and compare
  /// the combination's price with the product's cheapest. Deleting the product still takes the
  /// favourite, by its own cascade, before the statement's end checks this key.
  variantId  String?         @db.Uuid
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction)
  /// The combination's price when it was liked, or for one liked as a whole the cheapest combination
  /// on sale, in stock or not. Whole cents, never negative (a CHECK in the migration). Liking the
  /// same thing again keeps it; choosing another combination is a new like, with its own price and date.
  likedPriceCents Int
  likedAt         DateTime @default(now())

  @@unique([customerId, productId])
  /// The shopper's list, most recently liked first.
  @@index([customerId, likedAt(sort: Desc)])
  /// Who liked a product whose price dropped or whose stock came back (J16).
  @@index([productId])
  @@map("customer_favorites")
}
