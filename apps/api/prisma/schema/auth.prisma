/// A person with an account. The rules are in docs/product/README.md, "Accounts".
///
/// An account belongs to bee-link or to one shop. A shopkeeper's is bee-link's (`storeId` null) and
/// opens the panel; a shopper's belongs to the shop it was opened at and opens nothing else. The
/// e-mail is unique within each: the same address may have an account at every shop and one more at
/// bee-link, each with its own password.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  /// Stored trimmed and lower-cased, so uniqueness ignores case.
  email           String
  /// Null for an account that signs in only through an identity provider (Google, G5): it can set
  /// one later through "forgot my password", and until then a password sign-in never matches.
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// The shop a shopper's account belongs to; null for bee-link's own, a shopkeeper's.
  storeId         String?   @db.Uuid
  store           Store?    @relation("StoreAccounts", fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  emailTokens EmailToken[]
  /// The shops a bee-link account owns. A shop's account never owns one.
  stores      Store[]   @relation("StoreOwner")
  /// A shop account's record at its shop, which the shop owns and never reads this account through.
  customers   Customer[]
  /// The order statuses this account set, as a shopkeeper.
  orderEvents OrderEvent[]
  /// The providers this account signs in through besides its password (G5).
  identities  AccountIdentity[]
  pageVersions StorePageVersion[]

  @@unique([storeId, email])
  // The composite above leaves bee-link's accounts unconstrained — Postgres counts every null
  // `storeId` as distinct — so theirs is its own index.
  @@unique([email], where: { storeId: null }, map: "users_email_key")
  @@map("users")
}

enum IdentityProvider {
  GOOGLE
}

/// One provider's account tied to one shop's account: Google's `sub` for this person, at this shop.
/// A subject is tied once per shop — the unique triple — so one Google account never opens two
/// accounts at a shop, and at another shop it opens that shop's own.
model AccountIdentity {
  id        String           @id @default(uuid(7)) @db.Uuid
  provider  IdentityProvider
  /// The provider's stable id for the person — Google's `sub`, never the e-mail, which can change.
  subject   String
  /// The shop of the account it opens, repeated from it so the tie can be unique per shop.
  storeId   String           @db.Uuid
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([storeId, provider, subject])
  @@index([userId])
  @@map("account_identities")
}

/// A Google sign-in in flight: the state sent to Google, the PKCE verifier kept from it, the shop it
/// began at and where to return. Used once and short-lived; a row past `expiresAt` is refused.
model OAuthState {
  /// Random, sent to Google and back, and held in the browser's cookie to tie the flow to it.
  state        String   @id
  codeVerifier String
  storeId      String   @db.Uuid
  returnTo     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("oauth_states")
}

/// One signed-in device. Every refresh token it was ever given belongs to it, so reusing a spent
/// token can revoke the whole session at once.
/// Which door a session was opened through. One account, two doors, never the same session: a
/// shopper's token must never open a shopkeeper's panel, and the reverse.
enum SessionAudience {
  OWNER
  CUSTOMER
}

model Session {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  SessionAudience @default(OWNER)
  userAgent String?
  createdAt DateTime        @default(now())
  revokedAt DateTime?

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token, hex — the token itself is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  /// Set when the token is rotated. A token presented again after that is a leak.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// The single-use token behind an e-mailed link.
model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  /// SHA-256 of the token, hex.
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
  @@map("email_tokens")
}
