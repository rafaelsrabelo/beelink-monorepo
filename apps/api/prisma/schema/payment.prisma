/// Where an order is paid (BEELINK-204): settled between the shop and the customer, as before Asaas,
/// or charged at the shop's own Asaas account.
enum OrderPaymentChannel {
  OFFLINE
  ONLINE
}

/// Who charges an order paid online.
enum PaymentProvider {
  ASAAS
}

/// Where a charge stands. Paid is CONFIRMED or RECEIVED. OVERDUE is still payable at Asaas until it
/// is removed there. CANCELLED was removed from Asaas; FAILED is one Asaas refused to create.
enum OrderPaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
  FAILED
}

/// One attempt at charging an order online (BEELINK-204), apart from the order's own status: an order
/// may have several, and one alive at a time — every status but CANCELLED and FAILED — by the partial
/// unique index below. A row leaves the living only once Asaas confirmed its charge is gone, so two
/// charges of one order are never payable at once. Every amount is whole cents.
model OrderPayment {
  id       String          @id @default(uuid(7)) @db.Uuid
  orderId  String          @db.Uuid
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Repeated from the order, as `OrderLabel` does: a webhook finds a charge within its shop.
  storeId  String          @db.Uuid
  provider PaymentProvider @default(ASAAS)
  /// Asaas's id of the charge — the first instalment's, on a plan. Null only on a FAILED attempt.
  providerId            String? @unique @db.VarChar(64)
  /// Asaas's id of the whole instalment plan, when the card is paid in more than one.
  providerInstallmentId String? @db.VarChar(64)

  method        PaymentMethod
  installments  Int                @default(1)
  amountCents   Int
  refundedCents Int                @default(0)
  status        OrderPaymentStatus @default(PENDING)
  /// The status in Asaas's own word, which says more than ours: AWAITING_RISK_ANALYSIS, CHARGEBACK_REQUESTED…
  providerStatus String? @db.VarChar(40)
  /// What Asaas last refused about it, in its words, for the shop to read; never told to the customer.
  lastError      String? @db.VarChar(500)

  /// Asaas's hosted invoice: where a card is paid.
  invoiceUrl String? @db.VarChar(500)
  /// The Pix's copy-and-paste code and its QR (a PNG in base64), read from Asaas once.
  pixPayload String?
  pixImage   String?

  /// The due day sent to Asaas, a day of Brasília's calendar.
  dueDate     DateTime? @db.Date
  /// Until when it is offered here: the end of that day in Brasília, or sooner when the Pix's code ends sooner.
  expiresAt   DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  /// When Asaas was last heard about it, by whichever way (BEELINK-206): a customer's read asks again
  /// only a minute after.
  checkedAt   DateTime?
  /// How many times the reconciliation asked, and when it asks next — each wait longer than the last.
  /// Null once the charge is paid or gone: nothing is left to ask.
  checks      Int       @default(0)
  nextCheckAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId], where: raw("(status <> ALL (ARRAY['CANCELLED'::\"OrderPaymentStatus\", 'FAILED'::\"OrderPaymentStatus\"]))"), map: "order_payments_one_live_key")
  @@index([orderId, createdAt])
  @@index([storeId, status])
  @@index([nextCheckAt])
  @@map("order_payments")
}

/// Why money that arrived is not its order's payment (BEELINK-206).
enum StrayPaymentReason {
  /// The order had been cancelled when its charge was paid.
  ORDER_CANCELLED
  /// The order was already paid by another charge.
  ORDER_ALREADY_PAID
}

/// Money at the shop's Asaas account that its order did not ask for (BEELINK-206): a charge paid
/// after the order was cancelled, or a second charge paid for an order already paid. bee-link refunds
/// nothing on its own; the shop reads it on the order and decides (BEELINK-208). One per charge.
model OrderStrayPayment {
  id          String             @id @default(uuid(7)) @db.Uuid
  orderId     String             @db.Uuid
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId     String             @db.Uuid
  /// Asaas's id of the charge that was paid: what a refund is asked with.
  providerId  String             @unique @db.VarChar(64)
  reason      StrayPaymentReason
  method      PaymentMethod
  amountCents Int
  /// When bee-link learned of it.
  paidAt      DateTime
  createdAt   DateTime           @default(now())

  @@index([orderId, createdAt])
  @@map("order_stray_payments")
}

/// One event of a shop's Asaas webhook (BEELINK-206), written before it is answered: its id is what
/// makes a second delivery a no-op. Nothing of its body is kept — what it tells is read from the
/// shop's account — only which order it is about. One about a charge that is not bee-link's is
/// written already done, with no order. Done ones are pruned after a month.
model AsaasEvent {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Asaas's id of the event, `evt_…`; the SHA-256 of the body for one that came with none.
  eventId String @db.VarChar(160)
  /// `PAYMENT_RECEIVED`, `ACCESS_TOKEN_DISABLED`…
  event   String @db.VarChar(80)
  /// The order its charge belongs to; null for an event about the key, and for one left alone.
  orderId String? @db.Uuid
  /// What came of it: APPLIED, IGNORED, or GIVEN_UP after the last try. Null while it waits.
  outcome String? @db.VarChar(20)

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  processedAt   DateTime?
  lastError     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())

  @@unique([storeId, eventId])
  @@index([processedAt, nextAttemptAt])
  @@map("asaas_events")
}

/// A shop's customer as the shop's Asaas account knows them (BEELINK-204): the id a charge is made
/// for, kept so the account is asked once. Apart from the customer's record, whose `updatedAt` is the
/// customer's own. The CPF it was found by is kept: a record whose CPF changed is looked up again.
model AsaasCustomer {
  customerId String   @id @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId String   @db.VarChar(64)
  cpf        String   @db.Char(11)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("asaas_customers")
}

/// The news that an order charged online was paid (BEELINK-207), told once: the row is written by
/// the transaction that writes the payment, and its unique order id is what makes a repeated event,
/// a reconciliation or a card's CONFIRMED turning RECEIVED tell nothing again. It is the outbox of
/// the customer's e-mail — claimed and retried as every outbox is; one not owed (no confirmed
/// e-mail, or the notice turned off) is born with `sentAt` set — and what the panel's bell reads.
model OrderPaidNotice {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId String @db.Uuid

  /// When the panel was told in real time: taken once, by whoever tells first.
  toldAt DateTime?
  /// When somebody at the shop opened the order since: the bell stops telling of it.
  seenAt DateTime?

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  /// The bell's reading: a shop's paid orders nobody opened yet.
  @@index([storeId], where: raw("(\"seenAt\" IS NULL)"), map: "order_paid_notices_unseen_idx")
  /// The dispatcher's reading, as on every outbox.
  @@index([nextAttemptAt], where: raw("(\"sentAt\" IS NULL) AND (attempts < 5)"), map: "order_paid_notices_owed_idx")
  @@map("order_paid_notices")
}
