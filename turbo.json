{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate", "type-check"],
      "env": ["API_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build-storybook": { "outputs": ["storybook-static/**"] },
    "generate": { "cache": false },
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["API_URL"] },
    "storybook": { "cache": false, "persistent": true },
    "transit": { "dependsOn": ["^transit"] },
    "lint": { "dependsOn": ["transit"] },
    "type-check": { "dependsOn": ["transit", "generate"] },
    "test": { "dependsOn": ["transit", "generate"], "outputs": ["coverage/**"] },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "API_URL", "DATABASE_URL", "TEST_DATABASE_URL", "MAILPIT_URL"]
    }
  }
}
