/// Where an order stands. `CANCELLED` is final; the others are the shopkeeper's to move, back as well
/// as forward, since a status set by mistake has to be correctable.
enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// How the order is handed over.
enum OrderFulfillment {
  DELIVERY
  PICKUP
}

/// Who set a status: the shopkeeper, or the customer placing the order from the cart. The courier
/// app comes later.
/// What an order's quoted window counts in: minutes for the shop's own delivery, business days for a carrier.
enum ShippingWindowUnit {
  MINUTES
  BUSINESS_DAYS
}

enum OrderActor {
  SHOPKEEPER
  CUSTOMER
  SYSTEM
  /// A carrier, as Melhor Envio tells of a label posted or delivered (BEELINK-188).
  CARRIER
}

/// An order: a fact about the past, in the shop that sold it (docs/product/README.md, "Orders").
///
/// Its lines and totals are photographs taken when it was placed — a price change or a deleted
/// product never rewrites an order that already happened. Every amount is whole cents.
model Order {
  id         String           @id @default(uuid(7)) @db.Uuid
  storeId    String           @db.Uuid
  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Sequential within the shop, from `Store.orderSequence`: what a shopkeeper says on the phone.
  number     Int
  customerId String           @db.Uuid
  /// A customer with orders is part of the shop's books and cannot be deleted from under them.
  /// NoAction and not Restrict: checked at the end of the statement, so deleting the whole shop,
  /// which cascades to its customers and its orders together, still goes through.
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: NoAction)
  status     OrderStatus
  fulfillment OrderFulfillment
  /// A label for how the two of them settle it; nothing is charged by the product.
  paymentMethod PaymentMethod
  /// Where it is paid (BEELINK-204). OFFLINE: the method above is a label, as before. ONLINE: charged
  /// at the shop's Asaas account, by PIX or CREDIT_CARD only (a CHECK), in `payments`.
  paymentChannel      OrderPaymentChannel @default(OFFLINE)
  /// The instalments the customer chose, 1 unless it is an online card (a CHECK): kept here because an
  /// order may wait for its charge — a fee not agreed yet, Asaas not answering.
  paymentInstallments Int                 @default(1)
  /// Held, until this instant, by the one request talking to Asaas about this order's charge: taken
  /// under the shop's row lock and before any call, so two never create two charges. One that ran out
  /// without being cleared is a talk that ended nobody knows how — the next lists Asaas before creating.
  paymentClaimedUntil DateTime?
  /// Until when an order charged online waits to be paid (BEELINK-206): three days after its total
  /// closed — placed with it, or the shop agreeing the fee. Past it, unpaid, the order is cancelled.
  /// Null offline, and while the fee is not agreed.
  paymentDueAt        DateTime?

  subtotalCents    Int
  /// Zero on a pick-up. Null on a delivery whose fee is not agreed yet — "a combinar", never a free
  /// delivery, which is zero (BEELINK-170); a CHECK keeps null to deliveries. Typed by the
  /// shopkeeper until the delivery module computes it.
  deliveryFeeCents Int? @default(0)
  /// When the quote said a delivery would arrive, as the order was placed (BEELINK-178): all three or
  /// none. Apart from `OrderDelivery`, which is what the shopkeeper tells afterwards — this is the
  /// promise the customer read at checkout.
  deliveryWindowUnit ShippingWindowUnit?
  deliveryWindowFrom Int?
  deliveryWindowTo   Int?
  /// The CPF of who receives a carrier's delivery, photographed as the order was placed (BEELINK-187):
  /// its label is bought with it, whatever the customer's record says later.
  deliveryDocument   String? @db.VarChar(14)
  /// Everything taken off the order: the promotions, the coupon and what the shopkeeper typed.
  /// `totalCents = subtotalCents + deliveryFeeCents − discountCents`, as before the first two existed.
  discountCents    Int @default(0)
  /// Its parts (BEELINK-191), photographed like the rest; what is left of `discountCents` is the
  /// typed discount. The promotions' is the sum of the lines'. The coupon's, on a free delivery, is
  /// the fee — zero while that is not agreed, and set with it.
  promotionDiscountCents Int @default(0)
  couponDiscountCents    Int @default(0)
  /// The coupon as it was when the order took it: the coupon may be edited or paused since. Both or
  /// neither, by a CHECK. Which coupon it was is in `couponRedemption`.
  couponCode String?     @db.VarChar(30)
  couponKind CouponKind?
  totalCents       Int
  /// The cashback it earns once delivered (BEELINK-239), photographed when placed with the rate it was
  /// worked out at: a rule changed later applies to new orders only. 0, and a null rate, when it earns
  /// nothing — the cashback off, the order under the minimum, or too little to make a cent.
  cashbackEarnedCents Int  @default(0)
  cashbackRateBps     Int?
  /// The customer's credit it spent (BEELINK-240): taken off the total like a discount, but not one —
  /// a discount is margin the shop gives up now, credit is an old debt being paid, and the books keep
  /// the two apart. Never more than the products after their discounts, never the delivery.
  cashbackUsedCents   Int  @default(0)

  /// Where a delivery goes, photographed from the customer's record when the order is placed: the
  /// customer moving, or renaming themselves, never rewrites where an order went. Null on a pick-up,
  /// and on a delivery placed before orders kept it — which reads "not recorded", never today's
  /// address. `deliveryName` is who receives it.
  deliveryName         String?
  deliveryZipCode      String?
  deliveryStreet       String?
  deliveryNumber       String?
  deliveryComplement   String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryState        String?

  /// The shopkeeper's note on the order.
  note     String?  @db.VarChar(500)
  /// When it was sold — which may be before it was registered, never after now.
  placedAt DateTime
  /// Whether placing it took its counted lines off the stock, so cancelling gives them back. False
  /// on an order placed before orders counted stock: cancelling it returns nothing never taken.
  stockTaken Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  OrderItem[]
  events OrderEvent[]
  /// Who delivers it and when it should arrive — a delivery's alone, never a pick-up's.
  delivery OrderDelivery?
  /// Its shipping label, once the shopkeeper buys one (BEELINK-187).
  label    OrderLabel?
  /// The customer's conversation with the shop about it, once they wrote (BEELINK-160).
  conversation OrderConversation?
  /// The e-mails its moves owe the customer (BEELINK-151).
  statusEmails OrderStatusEmail[]
  /// The reviews it let its customer write (BEELINK-156).
  reviews ProductReview[]
  /// The coupon it took, when it took one (BEELINK-190).
  couponRedemption CouponRedemption?
  /// The credit it earns (BEELINK-238), once there is one.
  cashbackCredit  CashbackCredit?
  cashbackEntries CashbackEntry[]
  /// The lots its credit came from, when it spent any.
  cashbackRedemptions CashbackRedemption[]
  /// Its charges at Asaas, when it is paid online (BEELINK-204): every attempt, one alive at a time.
  payments OrderPayment[]
  strayPayments OrderStrayPayment[]
  paidNotice OrderPaidNotice?

  @@unique([storeId, number])
  @@index([storeId, placedAt])
  @@index([storeId, status])
  @@index([customerId, placedAt])
  @@index([paymentDueAt])
  @@map("orders")
}

/// One line: what was bought, how many, and the name and unit price as they were at that moment.
model OrderItem {
  id        String          @id @default(uuid(7)) @db.Uuid
  orderId   String          @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Kept while the product exists, so the panel can link to it; the line reads its photographs.
  productId String?         @db.Uuid
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName  String  @db.VarChar(160)
  /// "Sabor: Uva · Peso: 300 g" — null for a product with no options. Long enough for the catalog's
  /// worst case: three options of 40 characters, each with a value of 60, joined.
  variantLabel String? @db.VarChar(320)
  sku          String? @db.VarChar(64)

  /// The catalogue's price, and that price times the quantity: a promotion's discount stays apart.
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  /// What a promotion took off this line (BEELINK-191), never more than the line, and the promotion
  /// by its name as it was. The link is kept while the promotion exists.
  discountCents  Int        @default(0)
  promotionId    String?    @db.Uuid
  promotion      Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionName  String?    @db.VarChar(80)
  position       Int

  @@index([orderId, position])
  @@index([productId])
  @@index([variantId])
  @@index([promotionId])
  @@map("order_items")
}

/// Every status an order had, with who set it and when. The courier app will write "out for
/// delivery" and "delivered" here, so the history already says whose word it was.
model OrderEvent {
  id        String      @id @default(uuid(7)) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  actor     OrderActor
  /// The account behind it, when a person set it.
  userId    String?     @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Who brings a delivery: the shop itself, or a carrier.
enum OrderDeliveryKind {
  OWN
  CARRIER
}

/// How a delivery goes, as the shopkeeper tells it: who brings it, its tracking and the window it
/// should arrive in. A record of its own, beside the order, because the courier app and the carriers
/// will write it without touching the order (BEELINK-146).
model OrderDelivery {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  kind         OrderDeliveryKind
  /// "Correios", "Loggi" — the shopkeeper's words.
  carrier      String? @db.VarChar(60)
  /// "SEDEX", "PAC".
  service      String? @db.VarChar(60)
  /// Melhor Envio's id for the service, on a delivery the customer chose at checkout (BEELINK-186):
  /// what its label is bought with. Null on a delivery the shopkeeper told by hand.
  carrierServiceId Int?
  trackingCode String? @db.VarChar(60)
  trackingUrl  String? @db.VarChar(500)
  /// The window it should arrive in, as days of the shop's calendar: both or neither.
  estimateFrom DateTime? @db.Date
  estimateTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_deliveries")
}

/// An e-mail an order's move owes its customer (BEELINK-151): written by the transaction that moves the
/// order, sent after it commits, apart from it — so a move never fails, nor waits, for the mail. A row
/// is claimed by pushing `nextAttemptAt` ahead (`FOR UPDATE SKIP LOCKED`), so two processes never send
/// it twice, and tried again until `sentAt` or the last attempt.
model OrderStatusEmail {
  id            String      @id @default(uuid(7)) @db.Uuid
  orderId       String      @db.Uuid
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The status the order moved to: what the e-mail says, whatever the order is by the time it goes.
  status        OrderStatus
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  /// The order's own, for its cascade.
  @@index([orderId])
  /// The dispatcher's reading: what is still owed and may be tried again — nothing sent or given up.
  @@index([nextAttemptAt], where: raw("(\"sentAt\" IS NULL) AND (attempts < 5)"), map: "order_status_emails_owed_idx")
  @@map("order_status_emails")
}
