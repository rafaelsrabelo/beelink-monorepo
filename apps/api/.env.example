NODE_ENV=development
PORT=3001
API_PREFIX=api
DATABASE_URL=postgresql://harness:harness@localhost:5432/harness
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-you-deploy-this

# Mailpit catches everything in development: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Harness <nao-responda@harness.local>

# The links inside e-mails point at the web app
WEB_URL=http://localhost:3000

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute

# Per IP, on POST /stores and PUT /stores/:slug — each can drive an outbound geocoding call
STORE_WRITE_RATE_LIMIT_MAX=20
STORE_WRITE_RATE_LIMIT_WINDOW=1 minute

TRUST_PROXY=loopback

# Image uploads (Cloudinary). Leave all three empty and the API still serves everything else —
# uploads refuse with UPLOAD_NOT_CONFIGURED, which is a deliberate state, not a broken one.
#
# Server-side only, and never in a file that is committed. The legacy wrote these three into
# src/app/api/upload-image/route.ts as `||` fallbacks, in a public repository.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bee-link

# Uploads cost storage and bandwidth, so they are limited harder than an ordinary write.
UPLOAD_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_WINDOW=1 minute

# Per IP, on POST /stores/:slug/contact — the one write a stranger can make. The form's trap
# handles robots; this bounds a person who keeps resending.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW=10 minutes

# Address search and the map on the panel's address tab (MapTiler). Optional: without it the
# address is typed by hand and the map is not drawn.
#
# Server-side only. The geocoding call is billable, which is why it goes out from the API — where
# a bearer token is actually verified — and not from the web app's BFF.
MAPTILER_API_KEY=
ADDRESS_SEARCH_RATE_LIMIT_MAX=60
ADDRESS_SEARCH_RATE_LIMIT_WINDOW=1 minute
