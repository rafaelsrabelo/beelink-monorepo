NODE_ENV=development
PORT=3001
API_PREFIX=api
DATABASE_URL=postgresql://harness:harness@localhost:5432/harness
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-you-deploy-this

# Mailpit catches everything in development: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=bee-link <nao-responda@bee-link.local>

# The links inside e-mails point at the web app
WEB_URL=http://localhost:3000

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute

# Per IP, on POST /stores and PUT /stores/:slug — each can drive an outbound geocoding call
STORE_WRITE_RATE_LIMIT_MAX=20
STORE_WRITE_RATE_LIMIT_WINDOW=1 minute

# Orders a signed-in shopper places from the cart, per IP.
CUSTOMER_ORDER_RATE_LIMIT_MAX=10
CUSTOMER_ORDER_RATE_LIMIT_WINDOW=10 minutes
# Carts a signed-in shopper prices at checkout, coupon included, per IP.
CUSTOMER_QUOTE_RATE_LIMIT_MAX=30
CUSTOMER_QUOTE_RATE_LIMIT_WINDOW=5 minutes
CUSTOMER_MESSAGE_RATE_LIMIT_MAX=20
CUSTOMER_MESSAGE_RATE_LIMIT_WINDOW=1 minute

TRUST_PROXY=loopback

# Image uploads (Cloudinary). Leave all three empty and the API still serves everything else —
# uploads refuse with UPLOAD_NOT_CONFIGURED, which is a deliberate state, not a broken one.
#
# Server-side only, and never in a file that is committed. The legacy wrote these three into
# src/app/api/upload-image/route.ts as `||` fallbacks, in a public repository.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bee-link

# Uploads cost storage and bandwidth, so they are limited harder than an ordinary write.
UPLOAD_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_WINDOW=1 minute

# Per IP, on POST /stores/:slug/contact — the one write a stranger can make. The form's trap
# handles robots; this bounds a person who keeps resending.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW=10 minutes

# Address search and the map on the panel's address tab (MapTiler). Optional: without it the
# address is typed by hand and the map is not drawn.
#
# Server-side only. The geocoding call is billable, which is why it goes out from the API — where
# a bearer token is actually verified — and not from the web app's BFF.
MAPTILER_API_KEY=
ADDRESS_SEARCH_RATE_LIMIT_MAX=60
ADDRESS_SEARCH_RATE_LIMIT_WINDOW=1 minute

# Sign in with Google at a shop (G5). Optional: leave all three empty and the shop window shows no
# Google button. Set all three or none — half of it fails at boot.
#
# Created in the Google Cloud console (APIs & Services → Credentials → OAuth client ID, type "Web
# application"). The redirect URI is the web app's fixed callback, the same for every shop, and must
# be listed there exactly: e.g. http://localhost:3000/api/customer/google/callback in development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Melhor Envio (BEELINK-182) — bee-link's app at Melhor Envio, which each shop authorizes on its own
# account. All three or none, and then INTEGRATIONS_SECRET_KEY too. Create the app at
# https://sandbox.melhorenvio.com.br (Integrações → Área Dev.) for development; its callback must be
# exactly MELHOR_ENVIO_REDIRECT_URI. Without them the panel says carriers are not set up here.
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# The web's fixed callback, e.g. http://localhost:3000/api/integrations/melhor-envio/callback
MELHOR_ENVIO_REDIRECT_URI=
# Sent in the User-Agent, which Melhor Envio refuses a request without.
MELHOR_ENVIO_CONTACT_EMAIL=contato@beecoders.net

# Seals each shop's third-party access at rest: 32 bytes in base64 — `openssl rand -base64 32`.
# Losing it means every shop connects again; never commit a real one.
INTEGRATIONS_SECRET_KEY=
