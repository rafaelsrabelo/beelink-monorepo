/// How a courier delivers. The four the landing's form offers; a fifth is a migration, on purpose.
enum CourierVehicle {
  MOTORCYCLE
  BICYCLE
  CAR
  VAN
}

/// A person who asked to deliver with Beelink (BEELINK-321): what the landing's form sent.
///
/// A list of interest and nothing more. It has no status, because nobody works through it yet, and
/// no link to `users`, because asking is not an account. Nothing reads it but a person with `psql`.
///
/// A person is here once (BEELINK-325): a second application with a CPF, an e-mail or a WhatsApp
/// number already on the list is refused by the service, under a lock. Only the CPF has an index
/// of its own — rows from before the rule may repeat an e-mail or a number.
model CourierApplication {
  id String @id @default(uuid(7)) @db.Uuid

  /// As typed, trimmed, with a run of spaces read as one: a first name and a surname at least.
  name     String @db.VarChar(120)
  /// The CPF as its eleven digits, which a CHECK holds it to (`courier_applications_document_check`).
  document String @unique @db.Char(11)
  /// Trimmed and lower-cased. 254 is the address's own ceiling (RFC 5321).
  email    String @db.VarChar(254)
  /// Digits only, with the country code, the way a shop's WhatsApp is stored — `wa.me/<this>` is
  /// built from it. A CHECK holds it to digits (`courier_applications_whatsapp_check`).
  whatsapp String @db.VarChar(20)

  /// A `CourierCity` of the contracts, as its code: `FORTALEZA_CE`. Text and not an enum of the
  /// database, so opening a city is a change of code and never a migration.
  city    String         @db.VarChar(40)
  vehicle CourierVehicle

  /// The `LegalVersion` in force when the application arrived — the server's word, never the body's.
  termsVersion    String
  termsAcceptedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courier_applications")
}
