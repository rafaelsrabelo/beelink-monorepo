# The API this app's BFF forwards to. Defaults to the local NestJS app.
API_URL=http://localhost:3001/api

# Image uploads (Cloudinary). Leave all three empty and the panel still runs — uploads refuse with
# UPLOAD_NOT_CONFIGURED, which is a deliberate state, not a broken one.
#
# Server-only. There is no NEXT_PUBLIC twin and there must never be one: a secret in the bundle is
# a secret in every visitor's browser. Keep the real values in .env.local, which is not committed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bee-link
